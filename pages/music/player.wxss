/* pages/music/player.wxss */

/* 页面容器 */
.player-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* 使用更具现代感的渐变色 */
  background: linear-gradient(135deg, #0a0a0a 0%, #2d2d2d 100%);
  color: white;
  padding: 0 30rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 120rpx;
  position: relative;
  margin-bottom: 20rpx;
  background-color: rgba(0, 0, 0, 0.3); /* 添加半透明背景 */
  backdrop-filter: blur(10px); /* 毛玻璃效果 */

    backdrop-filter: blur(20px);
  background: rgba(255,255,255,0.1);
  border-radius: 0 0 20rpx 20rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.back-arrow {
  width: 30rpx;
  height: 30rpx;
  border-top: 4rpx solid white;
  border-left: 4rpx solid white;
  transform: rotate(-45deg);
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
    font-size: 38rpx;
  margin-top: 10rpx;
}
.nav-artist {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}
/* 主要内容区域 */
.main-content {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
  position: relative;
  overflow: hidden;
}

/* 封面区域 */
.cover-container {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
    perspective: 1000px;
}

.cover-image {
  width: 650rpx;
  height: 650rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5); /* 增强阴影效果 */
  transition: transform 0.5s ease;
  border: 10rpx solid rgba(255, 255, 255, 0.1);
    background: 
    linear-gradient(45deg, #fff3 0%, #fff1 100%) padding-box,
    linear-gradient(135deg, #ff6b6b30 0%, #4ecdc430 100%) border-box;
}
@keyframes float {
  0%, 100% { transform: translateY(0) rotate(var(--cover-rotate)); }
  50% { transform: translateY(-20rpx) rotate(var(--cover-rotate)); }
}
/* 歌词区域 */
.lyrics-container {
  width: 100%;
  height: 600rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: rgba(0, 0, 0, 0.3); /* 添加半透明背景 */
  backdrop-filter: blur(10px); /* 毛玻璃效果 */
  border-radius: 20rpx;
}

.lyrics-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.lyric-item {
  font-size: 30rpx;
  line-height: 2;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  transition: all 0.3s ease;
  padding: 10rpx 0;
}

.lyric-item.active {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
    opacity: 1;
  transform: scale(1);
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); /* 添加文字阴影 */
}

/* 歌曲信息 */
.song-info {
  text-align: center;
  margin: 30rpx 0;
}

.song-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-artist {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 进度条 */
.progress-container {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.progress-slider {
  flex: 1;
  margin: 0 20rpx;
    height: 4rpx !important;
  padding: 20rpx 0 !important;
}
.time-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  width: 80rpx;
  text-align: center;
  
}

/* 播放模式 */
.play-mode-container {
  display: flex;
  justify-content: center;
  margin: 20rpx 0;
}


.play-mode-btn {
  padding: 10rpx 30rpx;
  background-color: rgba(255, 255, 255, 0.1); /* 半透明背景 */
  border-radius: 30rpx;
  font-size: 24rpx;
  transition: background-color 0.3s ease;
}

.play-mode-btn:hover {
  background-color: rgba(255, 255, 255, 0.2); /* 悬停效果 */
}

/* 控制按钮 */
.controls-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0;
}
.control-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 30rpx;
  transition: transform 0.3s ease;
}

.control-btn:hover {
  transform: scale(1.1); /* 悬停放大效果 */
}

.prev-btn, .next-btn {
  width: 100rpx;
  height: 100rpx;
}

.play-btn {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

/* 播放/暂停图标 */
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 25rpx 0 25rpx 40rpx;
  border-color: transparent transparent transparent white;
  margin-left: 10rpx;
}

.pause-icon {
  width: 40rpx;
  height: 50rpx;
  border-style: solid;
  border-width: 0 12rpx 0 12rpx;
  border-color: transparent white transparent white;
}
/* 上一首/下一首图标 */
.prev-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 30rpx 20rpx 0;
  border-color: transparent white transparent transparent;
}

.next-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 0 20rpx 30rpx;
  border-color: transparent transparent transparent white;
}

/* 空容器 */
.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: linear-gradient(135deg, #121212, #2a2a2a);
  color: white;
}

.empty-container .back-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  transition: background-color 0.3s ease;
}

.empty-container .back-btn:hover {
  background-color: rgba(255, 255, 255, 0.2);
}


/* 旋转动画 */
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.rotating {
  animation: rotate 20s linear infinite;
}

/* 适配不同屏幕尺寸 */
@media screen and (max-height: 700px) {
  .cover-image {
    width: 400rpx;
    height: 400rpx;
  }
  
  .lyrics-container {
    height: 500rpx;
  }
  
  .controls-container {
    margin: 20rpx 0;
  }
}

@media screen and (min-height: 800px) {
  .cover-image {
    width: 600rpx;
    height: 600rpx;
  }
  
  .lyrics-container {
    height: 700rpx;
  }
}