/* pages/music/list.wxss */

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx; /* 为底部播放控制留出空间 */
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 120rpx;
  position: relative;
  background: linear-gradient(135deg, #2C3E50, #4CA1AF);
  padding: 0 30rpx;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.back-arrow {
  width: 30rpx;
  height: 30rpx;
  border-top: 4rpx solid white;
  border-left: 4rpx solid white;
  transform: rotate(-45deg);
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: white;
}

/* 页面标题 */
.header {
  padding: 40rpx 40rpx 30rpx;
  background: linear-gradient(135deg, #2C3E50, #4CA1AF);
  color: white;
}

.title-container {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 音乐列表 */
.music-list {
  padding: 20rpx;
}

.music-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.music-item.playing {
  background-color: rgba(76, 161, 175, 0.1);
  border-left: 8rpx solid #4CA1AF;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.artist {
  font-size: 26rpx;
  color: #666;
}

.controls {
  display: flex;
  align-items: center;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
}

/* 播放/暂停图标 */
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 0 20rpx 30rpx;
  border-color: transparent transparent transparent #4CA1AF;
}

.pause-icon {
  width: 30rpx;
  height: 40rpx;
  border-style: solid;
  border-width: 0 10rpx 0 10rpx;
  border-color: transparent #4CA1AF transparent #4CA1AF;
}

.next-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.next-icon:before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 20rpx;
  border-color: transparent transparent transparent #4CA1AF;
  left: 0;
}

.next-icon:after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 20rpx;
  border-color: transparent transparent transparent #4CA1AF;
  left: 15rpx;
}

.netease-btn {
  padding: 10rpx 20rpx;
  background-color: #D81E06;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-left: 20rpx;
}

/* 空列表提示 */
.empty-list {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* 当前播放信息 */
.now-playing {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.now-playing-info {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.mini-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.now-playing-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.now-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-artist {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-playing-controls {
  display: flex;
  align-items: center;
}