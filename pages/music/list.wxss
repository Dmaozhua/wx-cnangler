/* pages/music/list.wxss */

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #121212; /* 深色背景 */
  padding-bottom: 120rpx; /* 为底部播放控制留出空间 */
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  height: 120rpx;
  position: relative;
  background: linear-gradient(135deg, #121212, #2a2a2a);
  padding: 0 30rpx;
  backdrop-filter: blur(10px); /* 毛玻璃效果 */
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.back-arrow {
  width: 30rpx;
  height: 30rpx;
  border-top: 4rpx solid white;
  border-left: 4rpx solid white;
  transform: rotate(-45deg);
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: white;
}

/* 页面标题 */
.header {
  padding: 90rpx 40rpx 30rpx;
  background: linear-gradient(135deg, #121212, #2a2a2a);
  color: white;
}

.title-container {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 音乐列表 */
.music-list {
  padding: 20rpx;
}

.music-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: rgba(255, 255, 255, 0.1); /* 半透明背景 */
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.music-item:hover {
  background-color: rgba(255, 255, 255, 0.2); /* 悬停效果 */
  transform: translateY(-5rpx); /* 上移效果 */
}

.music-item.playing {
  background-color: rgba(76, 161, 175, 0.1);
  border-left: 8rpx solid #4CA1AF;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 30rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 10rpx;
}

.artist {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.controls {
  display: flex;
  align-items: center;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 20rpx;
  transition: transform 0.3s ease;
}

.control-btn:hover {
  transform: scale(1.1); /* 悬停放大效果 */
}

/* 播放/暂停图标 */
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 0 20rpx 30rpx;
  border-color: transparent transparent transparent #4CA1AF;
}

.pause-icon {
  width: 30rpx;
  height: 40rpx;
  border-style: solid;
  border-width: 0 10rpx 0 10rpx;
  border-color: transparent #4CA1AF transparent #4CA1AF;
}

.next-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.next-icon:before {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 20rpx;
  border-color: transparent transparent transparent #4CA1AF;
  left: 0;
}

.next-icon:after {
  content: '';
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 15rpx 0 15rpx 20rpx;
  border-color: transparent transparent transparent #4CA1AF;
  left: 15rpx;
}

.netease-btn {
  padding: 10rpx 20rpx;
  background-color: #D81E06;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-left: 20rpx;
  transition: background-color 0.3s ease;
}

.netease-btn:hover {
  background-color: #b41804; /* 悬停效果 */
}

/* 空列表提示 */
.empty-list {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* 当前播放信息 */
.now-playing {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 150rpx;
  background-color: rgba(0, 0, 0, 0.8); /* 半透明背景 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  backdrop-filter: blur(10px); /* 毛玻璃效果 */
}

.now-playing-info {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.mini-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.now-playing-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.now-title {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-artist {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.now-playing-controls {
  display: flex;
  align-items: center;
}

/* 浮动主页按钮 */
.float-home-btn {
  position: fixed;
  bottom: 190rpx; /* 调整为底部 80rpx，原 40rpx */
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #1E3A8A;
  color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
  transition: all 0.3s ease;
  opacity: 0.9; /* 稍微透明，减少视觉干扰 */
}

.float-btn-hover {
  transform: scale(0.95);
  background-color: #152a62;
}

.home-btn-text {
  font-size: 24rpx;
}