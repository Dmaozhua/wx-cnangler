<!-- pages/fishDetail/fishDetail.wxml -->
<view class="container" bindtouchstart="touchStart" bindtouchend="touchEnd">
  <!-- 顶部标题栏 -->
  <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
  <view class="header">

    <view class="title">鱼类详情</view>
  </view>

  <!-- 鱼类详情内容 -->
  <view class="fish-detail">
    <!-- 鱼类图片 -->
    <image class="fish-image" src="{{fishImageUrl}}" mode="aspectFit" binderror="handleImageError"></image>
    
    <!-- 基本信息 -->
    <view class="info-section">
      <view class="fish-name">{{fishInfo.name}}</view>
      <view class="fish-rarity">稀有度: {{rarityNames[fishInfo.rarity]}}</view>
      <view class="fish-description">{{fishInfo.description}}</view>
    </view>
    
    <!-- 收集统计 -->
    <view class="stats-section">
      <view class="stats-title">收集统计</view>
      <view class="stats-item">
        <text class="stats-label">捕获次数:</text>
        <text class="stats-value">{{collectionInfo.count || 0}}次</text>
      </view>
      <view class="stats-item">
        <text class="stats-label">最小体型比例:</text>
        <text class="stats-value">{{collectionInfo.minStrength || 0}}</text>
      </view>
      <view class="stats-item">
        <text class="stats-label">最大体型比例:</text>
        <text class="stats-value">{{collectionInfo.maxStrength || 0}}</text>
      </view>
    </view>

    <!-- 图片展示模块 -->
    <view class="image-gallery-section">
      <view class="gallery-title">更多图片</view>
      <view class="image-gallery">
        <block wx:for="{{serverImages}}" wx:key="index">
          <view class="image-item" wx:if="{{item.loaded && !item.error}}">
            <image 
              class="gallery-image" 
              src="{{item.url}}" 
              mode="aspectFill"
              data-url="{{item.url}}"
              data-index="{{index}}"
              bindtap="onImageTap"
              binderror="onServerImageError"
            ></image>
          </view>
        </block>
        <!-- 当没有图片时显示默认文本 -->
        <view class="no-images" wx:if="{{showNoImagesText}}">
          <text class="no-images-text">暂无更多，作者正在谋划中</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 图片放大模态框 -->
  <view class="image-modal" wx:if="{{showImageModal}}" bindtap="closeImageModal">
    <view class="modal-overlay"></view>
    <view class="modal-content" catchtap="">
      <image 
        class="modal-image" 
        src="{{currentImageUrl}}" 
        mode="aspectFit"
      ></image>
    </view>
  </view>
</view>