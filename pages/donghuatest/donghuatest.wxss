/* donghuatest.wxss */
.container {
  padding: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
  color: #333;
}

/* 拆分组件演示区域 */
.split-components-section {
  margin-bottom: 60rpx;
  padding: 40rpx;
  background-color: #ffffff;
  border: 6rpx solid #000000;
  box-shadow: 12rpx 12rpx 0 #000000;
}

.component-demo {
  margin-bottom: 60rpx;
  padding: 30rpx;
  background-color: #f8f8f8;
  border: 4rpx solid #000000;
  box-shadow: 8rpx 8rpx 0 #000000;
}

.demo-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #000000;
  display: block;
  border-bottom: 3rpx solid #000000;
  padding-bottom: 15rpx;
}

/* 完整组件库区域 */
.full-library-section {
  margin-bottom: 60rpx;
}

.animation-container {
  margin-top: 20rpx;
  padding: 20rpx;
}

/* 控制按钮样式 */
.loading-controls,
.progress-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 30rpx;
  justify-content: center;
}

.loading-controls neo-button,
.progress-controls neo-button {
  flex: 0 0 auto;
  margin: 5rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
}

/* 新增组件演示样式 */
.new-components-section {
  margin-top: 40rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.component-demo {
  margin-bottom: 40rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
  border-left: 4rpx solid #007aff;
}

.component-demo:last-child {
  margin-bottom: 0;
}

.demo-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.progress-controls {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.progress-controls neo-button {
  flex: 1;
  min-width: 120rpx;
}

.animation-section {
  margin-top: 60rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
  display: block;
  border-left: 8rpx solid #000000;
  padding-left: 20rpx;
}

/* 按钮组件间距 */
neo-button {
  margin: 10rpx;
  display: inline-block;
}

/* 卡片组件间距 */
neo-card {
  margin-bottom: 20rpx;
}

/* 输入框组件间距 */
neo-input {
  margin-bottom: 20rpx;
}

/* 圆形动画组件样式 */
circular-animations {
  display: block;
  width: 100%;
  background-color: #000;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

/* 确保动画组件在页面中正确显示 */
.component-demo circular-animations {
  min-height: 400rpx;
  overflow: hidden;
}