<!--pages/fishing/fishing.wxml-->
<page-meta>
    <!-- 自定义导航栏 -->
    <navigation-bar title="钓鱼中" background="#BDC3C7" color="#000000" back="{{false}}"></navigation-bar>
</page-meta>

<!-- 页面级加载动画 -->
<global-loading wx:if="{{pageLoading}}" show="{{pageLoading}}" text="{{pageLoadingText}}" />
<!-- 新增背景图容器 -->
<view class="scene-bg-container">
    <image class="scene-bg {{sceneBgFadeIn ? 'scene-bg-fade-in' : ''}}" src="{{backgroundImage}}" mode="aspectFill"></image>
</view>

<!-- 钓鱼成功弹窗 -->
<view class="fish-caught-popup {{showFishCaughtPopup ? 'show' : ''}}">
    <view class="fish-caught-content">
        <neo-card title="成功钓起" 
                  bg-color="rgba(52, 152, 219, 0.95)"
                  border-color="#ffffff"
                  text-color="#ffffff">
            <view class="fish-caught-body">
                <view class="fish-illustration" style="background-image: url('{{caughtFish.img}}')"></view>
                <view class="fish-caught-name">{{caughtFish.name}}</view>
                <view class="info-item">
    <text class="fish-caught-label">强度比：</text>
    <text class="fish-caught-value {{caughtFish.strengthRatio >= 20 && caughtFish.strengthRatio < 80 ? 'strength-normal' : ''}} {{(caughtFish.strengthRatio >= 10 && caughtFish.strengthRatio < 20) || (caughtFish.strengthRatio >= 80 && caughtFish.strengthRatio < 90) ? 'strength-warning' : ''}} {{(caughtFish.strengthRatio > 0 && caughtFish.strengthRatio <= 10) || (caughtFish.strengthRatio >= 90 && caughtFish.strengthRatio < 100) ? 'strength-extreme' : ''}} {{caughtFish.strengthRatio === 0 || caughtFish.strengthRatio === 100 ? 'strength-perfect' : ''}}">{{caughtFish.strengthRatio}}%</text>
</view>
<view class="info-item">
    <text class="fish-caught-label">搏鱼时间：</text>
    <text class="fish-caught-value">{{caughtFish.battleTime}}</text>
</view>
            </view>
            <view class="fish-caught-footer">
                <neo-button text="确认" 
                           bg-color="#FFFFFF" 
                           text-color="#2980b9"
                           bind:tap="onCloseFishCaughtPopup">
                </neo-button>
            </view>
        </neo-card>
    </view>
</view>

<!-- 鱼状态组件 -->
<fish-status 
    currentFish="{{currentFish}}" 
    playerHP="{{playerHP}}" 
    visible="{{showFishStatus}}" 
    qteState="{{qteStatusText}}" 
    bind:animationEnd="onFishStatusAnimationEnd"
    bind:lockInteraction="onFishStatusLockInteraction"
></fish-status>

<view class="container">
    <!-- 返回准备页面按钮 -->
    <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
    </view>


 <!-- 新增组合容器 -->
 <view class="combined-container">
        <view class="top-container">
            <!-- 状态信息区域 -->
            <view class="status-bar-container">
                <neo-card title="剩余时间" bg-color="rgba(255, 255, 255, 0.9)" border-color="#1E3A8A">
                    <view class="status-item">
                        <text class="status-value">{{fishingTimePercent}}%</text>
                        <view class="neo-progress">
                            <view class="progress-bar time-progress-inner" style="{{'width:' + fishingTimePercent + '%'}}"></view>
                        </view>
                    </view>
                </neo-card>
            </view>
            <view class="bottom-info-container">
                <neo-card title="鱼获记录" bg-color="rgba(255, 255, 255, 0.9)" border-color="#1E3A8A">
                    <view class="bottom-info-content">
                        <view class="info-item">
                            <text class="info-label">钓起</text>
                            <text class="info-value">{{fishCaught || 0}}条</text>
                        </view>
                        <view class="info-item">
                            <text class="info-label">脱钩</text>
                            <text class="info-value">{{sessionFishEscaped || 0}}条</text>
                        </view>
                    </view>
                </neo-card>
            </view>
        </view>
        <!-- 事件加成显示区域 -->
        <view class="event-buffs-container">
            <neo-card title="事件加成" bg-color="rgba(255, 255, 255, 0.9)" border-color="#1E3A8A">
                <view class="event-buffs-content" wx:if="{{hasEventBuffs}}">
                    <view class="event-buffs-list">
                        <view class="event-buff-item" wx:for="{{eventBuffs}}" wx:key="type">
                            <text class="event-buff-text">{{item.description}}</text>
                        </view>
                    </view>
                </view>
                <view class="event-buffs-content" wx:else>
                    <view class="event-buffs-empty">
                        <text>暂无事件</text>
                    </view>
                </view>
            </neo-card>
        </view>
    </view>
    
    <!-- 钓鱼场景 -->
    <view class="fishing-scene">
        <!-- 等待状态 -->
        <view class="fishing-status waiting" wx:if="{{state === 'waiting'}}">
            <text class="status-text">准备抛竿</text>
            <view class="cast-btn-container">
                <neo-button text="抛竿" bg-color="#FFD166" text-color="#000" bind:tap="onCastRod"    class="big-cast-btn"  ></neo-button>
            </view>
        </view>
        
        <!-- 鱼咬钩状态 -->
        <view class="fishing-status fishon" wx:if="{{state === 'fishon'}}">
            <text class="status-text">鱼儿上钩了！</text>
        </view>
        
        <!-- QTE状态 -->
        <view class="fishing-status qte" wx:if="{{state === 'qte'}}">
            <view class="qte-container">
                <text class="qte-title">{{qteData.description}}</text>
                <text class="qte-timer">剩余时间: {{qteTimeLeft}}</text>
                <view class="qte-options">
                    <neo-button 
                        wx:for="{{qteOptions}}" 
                        wx:key="index" 
                        text="{{item.description}}"
                        bg-color="#FFD166" 
                        text-color="#000"
                        data-option="{{item.key}}" 
                        bind:tap="onQteSelect"
                        bind:touchend="onQteTouchEnd"
                    ></neo-button>
                </view>
            </view>
        </view>
    </view>
    
    <!-- 底部信息区 -->
    <!-- <view class="bottom-info">
        <view class="info-item">
            <text class="info-label">已钓起</text>
            <text class="info-value">{{fishCaught || 0}}条</text>
        </view>
        <view class="info-item">
            <text class="info-label">脱钩</text>
            <text class="info-value">{{sessionFishEscaped || 0}}条</text>
        </view>
    </view> -->
    
    <!-- 自定义事件弹窗 -->
    <view class="custom-modal {{showCustomModal ? 'visible' : 'hidden'}}">
        <view class="modal-content" catchtap="stopPropagation">
            <text class="modal-title">{{customModalData.title}}</text>
            <text class="modal-text">{{customModalData.content}}</text>
            <button class="neo-button" bindtap="hideCustomModal">
                确定
            </button>
        </view>
    </view>

    <!-- 自定义tooltip -->
    <view class="custom-tooltip {{showCustomTooltip ? 'visible' : 'hidden'}}" wx:if="{{showCustomTooltip}}">
        <view class="tooltip-content">{{customTooltipData.content}}</view>
    </view>
</view>