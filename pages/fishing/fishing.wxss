.status-text {
  color: rgb(8, 6, 6);
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 30rpx;
}

.cast-btn-container {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  position: relative;
  z-index: 20;
}

.cast-btn {
  background-color: #1E3A8A;
  color: rgb(151, 143, 143);
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 20;
  min-width: 200rpx;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}

.fish-info {
  background-color: rgba(255, 255, 255, 0.8);
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  width: 80%;
}

.fish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
  text-align: center;
}

.fish-progress {
  width: 100%;
}

.qte-container {
  background-color: rgba(255, 255, 255, 0.9);
  padding: 30rpx;
  border-radius: 12rpx;
  width: 80%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.qte-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1E3A8A;
  margin-bottom: 20rpx;
  display: block;
  text-align: center;
}

.qte-timer {
  font-size: 30rpx;
  color: #ff4d4f;
  margin-bottom: 30rpx;
  display: block;
  text-align: center;
}

.qte-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.qte-option-btn {
  background: linear-gradient(135deg,rgb(98, 108, 117) 0%,rgb(142, 175, 178) 100%);
  color: white;
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 40rpx;
  border: none;
  margin: 0 10rpx;
  min-width: 200rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.qte-option-btn.active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.qte-option-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
  background: linear-gradient(135deg, #3d9fe8 0%, #00dbe4 100%);
}

.bottom-info {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background-color: white;
  margin: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #666;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1E3A8A;
}

/* 事件加成显示区域样式 */
.event-buffs-container {
  display: flex;
  flex-direction: column;
  background-color: white;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.event-buffs-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E3A8A;
  margin-bottom: 10rpx;
}

.event-buffs-list {
  display: flex;
  flex-direction: column;
}

.event-buff-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.event-buff-text {
  font-size: 26rpx;
  color: #333;
}

.event-buffs-empty {
  display: flex;
  justify-content: center;
  padding: 10rpx 0;
}

.event-buffs-empty text {
  font-size: 26rpx;
  color: #999;
}