/* pages/fishing/fishing.wxss */
page {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden; /* 防止页面滚动 */
    background: linear-gradient(135deg, #87CEEB 20%, #00BFFF 60%, #008B8B 100%);
}

/* 钓鱼成功弹窗样式 */
.fish-caught-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 139, 139, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
}

.fish-caught-popup.show {
    opacity: 1;
    visibility: visible;
}

.fish-caught-content {
    width: 80%;
    max-width: 600rpx;
    animation: popup-appear 0.5s forwards;
}

.fish-caught-content neo-card {
    border-radius: 20rpx;
    box-shadow: 0 4rpx 30rpx rgba(0, 0, 0, 0.3);
}

@keyframes popup-appear {
    0% {
        transform: translateY(-50rpx) scale(0.9);
        opacity: 0;
    }
    100% {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
}

.fish-caught-header {
    padding: 40rpx 30rpx 20rpx;
    text-align: center;
    border-bottom: 2rpx solid rgba(255, 255, 255, 0.2);
    
}

.fish-caught-title {
    font-size: 48rpx;
    color: #FFFAFA;
    font-weight: bold;
    text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3),
                 0 0 12rpx rgba(255, 255, 255, 0.5);
}

.fish-caught-body {
    padding: 40rpx 30rpx;
    text-align: center;
}

/* 鱼类插图样式 */
.fish-illustration {
    width: 200rpx;
    height: 200rpx;
    margin: 0 auto 30rpx;
    background: linear-gradient(135deg, #74b9ff, #0984e3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80rpx;
    color: white;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
    box-shadow: 0 4rpx 20rpx rgba(116, 185, 255, 0.4);
}

.fish-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 20rpx;
    text-align: center;
}

.fish-info {
    margin: 30rpx 0;
}

.confirm-btn-container {
    margin-top: 30rpx;
    text-align: center;
}

.fish-caught-name {
    font-size: 48rpx;
    color: #ffffff;
    font-weight: bold;
    margin-bottom: 30rpx;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.fish-caught-info {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 20rpx;
}
/* 标签样式 */
.fish-caught-label {
    font-size: 32rpx;
    color: #B0E0E6;
    min-width: 180rpx; /* 增加标签宽度 */
    text-align: right; /* 右对齐 */
    padding-right: 24rpx; /* 标签右侧间距 */
  }
  

/* 值样式 */
.fish-caught-value {
    font-size: 40rpx;
    color: #FFD700;
    text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
    flex-grow: 1;
    font-weight: bold; /* 加粗字体 */
}

/* 正常范围 20%-80% 白色 */
.strength-normal {
    color: #FFFFFF;
    text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.7);
}

/* 警告范围 10%-20% 和 80%-90% 黄色 */
.strength-warning {
    color: #FFD700;
    text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.5);
}

/* 极值范围 0%-10%左开右闭 和 90%-100%左闭右开 黑金渐变 + 闪烁 */
.strength-extreme {
    background: linear-gradient(45deg, #000000, #FFD700, #000000, #FFD700);
    background-size: 400% 400%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: extreme-shimmer 1.5s infinite, extreme-blink 0.8s infinite;
    text-shadow: none;
}

/* 完美值 0% 和 100% 黑红金渐变 + 闪烁 */
.strength-perfect {
    background: linear-gradient(45deg,rgb(119, 27, 212),rgb(221, 120, 234), #FFD700,rgb(221, 120, 234), #000000);
    background-size: 500% 500%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: perfect-shimmer 1.2s infinite, perfect-blink 0.6s infinite;
    text-shadow: none;
}

/* 极值强度特殊效果（保留兼容性） */
.extreme-strength {
    color: #FF4500;
    animation: extreme-glow 1.2s infinite alternate;
}

@keyframes pulse-glow {
    0% {
        text-shadow: 0 0 10rpx #FF4500, 0 0 20rpx rgba(255, 69, 0, 0.5);
        transform: scale(1);
    }
    100% {
        text-shadow: 0 0 20rpx #FF4500, 0 0 30rpx rgba(255, 69, 0, 0.8);
        transform: scale(1.05);
    }
}

/* 黑金渐变流动动画 */
@keyframes extreme-shimmer {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}

/* 闪烁动画 */
@keyframes extreme-blink {
    0%, 50% {
        opacity: 1;
    }
    25%, 75% {
        opacity: 0.7;
    }
}

/* 完美值黑红金渐变流动动画 */
@keyframes perfect-shimmer {
    0% {
        background-position: 0% 50%;
    }
    25% {
        background-position: 50% 25%;
    }
    50% {
        background-position: 100% 50%;
    }
    75% {
        background-position: 50% 75%;
    }
    100% {
        background-position: 0% 50%;
    }
}

/* 完美值闪烁动画 */
@keyframes perfect-blink {
    0%, 40% {
        opacity: 1;
    }
    20%, 60% {
        opacity: 0.6;
    }
}

.fish-caught-footer {
    padding: 20rpx;
    text-align: center;
}

.fish-caught-btn {
    background-color: #ffffff;
    color: #2980b9;
    font-size: 32rpx;
    font-weight: bold;
    padding: 16rpx 40rpx;
    border-radius: 50rpx;
    border: none;
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
    transition: all 0.3s;
}

.fish-caught-btn:active {
    transform: scale(0.95);
    box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.2);
}

/* 返回按钮样式 */
.back-btn {
    position: absolute;
    top: 100rpx;
    left: 30rpx;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    transition: background-color 0.3s;
}

.back-btn:hover {
    background-color: rgba(255, 255, 255, 0.5);
}

.back-icon {
    font-size: 30rpx;
    color: white;
    font-weight: bold;
}

.back-text {
    font-size: 28rpx;
}

.container {
    position: relative;
    min-height: 100vh;
    background-color: transparent;
    padding-top: 100rpx;
    box-sizing: border-box;
    z-index: 1;
    display: flex; /* 明确声明 Flex 容器 */
    flex-direction: column;
    align-items: flex-start; /* 关键代码 */
}
/* 原有的status-bar样式已被neo-card替代 */
.status-bar-container {
    display: flex;
    flex: 1;
    justify-content: space-between;
    margin: 0;
    margin-left: 120rpx;
    width: 200rpx;
}

.status-bar-container neo-card {
    width: 100%;
    padding: 20rpx;
}
/* 原有的bottom-info样式已被neo-card替代 */
.bottom-info-container {
    flex: 1;
    display: flex;
    justify-content: space-around;
    margin: 0;
    margin-right: 120rpx;
    width: 200rpx;
}

.bottom-info-container neo-card {
    width: 100%;
    padding: 20rpx;
}

.bottom-info-content {
    display: flex;
    justify-content: space-around;
}
/* 事件加成显示区域样式 - 已被neo-card替代 */
.event-buffs-container {
    display: flex;
    flex-direction: column;
    margin: 0;
    margin-right: 120rpx;
    margin-left: 120rpx;
    box-sizing: border-box;
}

.event-buffs-container neo-card {
    width: 100%;
    padding: 16rpx;
}

.event-buffs-content {
    display: flex;
    flex-direction: column;
}

.status-item {
    flex: 1; /* 等价于 flex-grow: 1; flex-shrink: 1; flex-basis: 0; */
    flex-direction: column;
}

.status-label {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 8rpx;
}

.status-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #1E3A8A;
}

.line-progress {
    width: 200rpx;
    margin-top: 10rpx;
}

/* Neo Progress 样式 */
.neo-progress {
    width: 100%;
    max-width: 400rpx;
    height: 32rpx;
    background-color: #e0e0e0;
    border: 6rpx solid #000000;
    box-shadow: 8rpx 8rpx 0 #000000;
    overflow: hidden;
    margin-top: 10rpx;
}

.progress-bar {
    height: 100%;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); /* 平滑过渡效果 */
}

.time-progress-inner {
    background-color: #4CAF50;
}

.fishing-scene {
    position: fixed; /* 使用fixed定位脱离文档流 */
    top: 0;
    left: 0;
    width: 100%; /* 宽度占满屏幕 */
    height: 100vh; /* 高度占满屏幕 */
    z-index: 999; /* 设置较高的z-index确保显示在最上层 */
    margin: 0; /* 移除左右边距 */
    border-radius: 0; /* 移除圆角 */
    box-shadow: none; /* 移除阴影 */
}

/* 背景图专用容器 */
.scene-bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    background-color: rgba(0, 0, 0, 0.3);
}

.scene-bg {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    opacity: 0; /* 初始透明度为0，用于淡入效果 */
    transition: opacity 0.5s ease; /* 添加过渡效果 */
}

/* 背景淡入动画 */
.scene-bg-fade-in {
    opacity: 1; /* 修改为完全不透明，解决背景模糊问题 */
}

.fishing-status {
    position: absolute;
    top: 75%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 999;
    background-color: rgba(255, 255, 255, 0.199); /* 半透明背景 */
    border-radius: 12rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.status-text {
    color: #1E3A8A;
    font-size: 36rpx;
    font-weight: bold;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
    margin-bottom: 30rpx;
}

/* cast-btn样式已被neo-button替代 */
.cast-btn-container {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 40rpx;
    padding: 0 60rpx;
    
}

.big-cast-btn {
    transform: scale(1.3); /* 放大1.2倍，可调整数值 */
    transform-origin: center; /* 缩放中心点为中心 */
  }
.fish-info {
    background-color: rgba(255, 255, 255, 0.8);
    padding: 20rpx;
    border-radius: 10rpx;
    margin-bottom: 30rpx;
    width: 80%;
}

.fish-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
    display: block;
    text-align: center;
}

.fish-progress {
    width: 100%;
}

.qte-container {
    background-color: rgba(255, 255, 255, 0.9);
    padding: 30rpx;
    border-radius: 12rpx;
    width: 80%;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.qte-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #1E3A8A;
    margin-bottom: 20rpx;
    display: block;
    text-align: center;
}

.qte-timer {
    font-size: 30rpx;
    color: #ff774d;
    margin-bottom: 30rpx;
    display: block;
    text-align: center;
}
.qte-options {
    /* 改用网格布局，更适合按钮数量不固定的情况 */
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150rpx, 1fr)); /* 增加最小宽度 */
    gap: 24rpx; /* 增加间距到24rpx */
    justify-items: center;
    padding: 0 30rpx; /* 增加左右内边距 */
    margin: 10rpx 0; /* 增加上下外边距 */
}




.qte-options neo-button {
    min-width: 140rpx;
    margin: 0; /* 移除边距，使用网格间隙 */
}

/* 信息项样式 */
.info-item {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid rgba(176, 224, 230, 0.2); /* 分隔线 */
  }

.info-label {
    font-size: 24rpx;
    color: #666;
}
.info-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #1E3A8A;
}
/* 新增组合容器样式 */
.combined-container {
    position: absolute;
    top: 10%; /* 调整到屏幕中上位置 */
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 20rpx; /* 上下之间的间距 */
    width: 99%; /* 组合容器的宽度 */
    max-width: 1200rpx; /* 最大宽度 */
}

.top-container {
    display: flex;
    gap: 1rpx; 
    width: 100%; /* 明确父容器宽度为100% */
}



.event-buffs-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #1E3A8A;
    margin-bottom: 10rpx;
}

.event-buffs-list {
    display: flex;
    flex-direction: column;
}

.event-buff-item {
    display: flex;
    align-items: center;
    padding: 8rpx 0;
}

.event-buff-text {
    font-size: 26rpx;
    color: #333;
}

.event-buffs-empty {
    display: flex;
    justify-content: center;
    padding: 10rpx 0;
}

.event-buffs-empty text {
    font-size: 26rpx;
    color: #999;
}

/* 自定义事件弹窗样式 */
.custom-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
}

.custom-modal.visible {
    opacity: 1;
    visibility: visible;
}

.custom-modal.hidden {
    opacity: 0;
    visibility: hidden;
}

.custom-modal .modal-content {
    background-color: #ffffff;
    border: 8rpx solid #000000;
    box-shadow: 16rpx 16rpx 0 #000000;
    padding: 48rpx;
    margin: 32rpx;
    max-width: 600rpx;
    width: 90%;
    animation: modal-appear 0.3s forwards;
}

.custom-modal .modal-title {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
    color: #1a1a1a;
}

.custom-modal .modal-text {
    display: block;
    font-size: 28rpx;
    margin-bottom: 32rpx;
    color: #333;
    line-height: 1.5;
}

.custom-modal .neo-button {
    width: 100%;
    background-color: #FFD700;
    border: 4rpx solid #000000;
    box-shadow: 8rpx 8rpx 0 #000000;
    padding: 20rpx;
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
}

@keyframes modal-appear {
    0% {
        transform: translateY(-50rpx) scale(0.9);
        opacity: 0;
    }
    100% {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
}

/* 自定义tooltip样式 */
.custom-tooltip {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10000;
    transition: all 0.3s ease;
}

.custom-tooltip.hidden {
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -50%) scale(0.8);
}

.custom-tooltip.visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
}

.custom-tooltip .tooltip-content {
    background: #000;
    color: #fff;
    padding: 12rpx 24rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    font-weight: 600;
    border: 4rpx solid #000;
    box-shadow: 6rpx 6rpx 0 #ff6b35;
    max-width: 500rpx;
    text-align: center;
    word-wrap: break-word;
}