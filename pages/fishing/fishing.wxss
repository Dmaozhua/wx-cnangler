/* pages/fishing/fishing.wxss */
page {
    position: relative;
     width: 100vw;
     height: 100vh;
     overflow: hidden; /* 防止页面滚动 */
   }

/* 返回按钮样式 */
.back-btn {
  position: absolute;
  top: 100rpx;
  left: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.back-icon {
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.back-text {
  font-size: 28rpx;
}
.container {
  /* display: flex;
  flex-direction: column;
  height: 100vh;
   width: 100%; 新增 */
   position: relative;
   min-height: 100vh;
   background-color: transparent; /* 移除灰色背景 */
   padding-top: 120rpx;
   box-sizing: border-box;
   z-index: 1; /* 创建新的层叠上下文 */
}

.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  background-color: white;
  border-radius: 12rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.status-item {
  display: flex;
  flex-direction: column;
}

.status-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.status-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1E3A8A;
}

.line-progress {
  width: 200rpx;
  margin-top: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #444444;
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.progress-inner {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); /* 平滑过渡效果 */
}

.time-progress-inner {
  background-color: #4CAF50;
}

.fishing-scene {
    position: relative;
    margin: 0 20rpx;
    border-radius: 12rpx;
    min-height: 60vh; /* 保证最小高度 */
    z-index: 1; /* 确保在背景之上 */
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  /* flex: 1;
  position: relative;
  margin: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);

  width: 100%; 新增 */
}
