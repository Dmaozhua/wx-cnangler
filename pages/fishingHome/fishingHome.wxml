<!-- pages/fishingHome/fishingHome.wxml -->
<view class="container" style="background-image: url('/images/icons/BG.webp');">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">←</text>
  </view>
  
  <!-- 帮助按钮 -->
  <view class="help-btn" bindtap="toggleTips">
    <text class="help-icon">i</text>
  </view>
  
  <!-- 游戏标题 -->
  <!-- <view class="title-container">
    <view class="title-box">  新增标题背景框 -->
    <!-- <view class="game-title">路亚模拟器</view>
    <view class="version">v0.1</view>
  </view> -->
    <!-- </view> -->
  
  <!-- 开始按钮 -->
  <view class="start-btn-container">
    <button class="start-btn" hover-class="btn-hover" bindtap="startFishing">Let's go lure fishing</button>
    <button class="collection-btn" hover-class="btn-hover" bindtap="openFishCollection">图鉴</button>
  </view>
  
  <!-- 帮助提示弹窗 -->
  <view class="tips-modal" wx:if="{{showTips}}">
    <view class="tips-content">
      <view class="tips-header">
        <text class="tips-title">钓鱼帮助</text>
        <text class="close-btn" bindtap="toggleTips">×</text>
      </view>
      <view class="tips-body">
        {{tipsContent}}
      </view>
    </view>
  </view>
</view>