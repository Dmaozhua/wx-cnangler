<!-- pages/fishingHome/fishingHome.wxml -->
<!-- 新增最底层背景层，解决不同设备显示问题 -->
<view class="background-layer"></view>

<view class="container" style="background-image: url('https://anglertest.xyz/game/BG/tittle/14.webp');">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">←</text>
  </view>
  
  <!-- 帮助按钮 -->
  <view class="help-btn" bindtap="toggleTips">
    <text class="help-icon">i</text>
  </view>
  
  <!-- 游戏标题 -->
<view 
    class="logo-container {{logoAnimated ? 'animated' : ''}}">
    <image class="game-logo" src="https://anglertest.xyz/game/fishlogo.webp" mode="aspectFit"></image>
</view>

  
  <!-- 开始按钮 -->
  <view class="start-btn-container">
  <!-- 使用 view 包裹图片，并绑定点击事件 -->
  <view class="start-btn-wrapper" bindtap="startFishing">
    <!-- 图片按钮，设置 mode="widthFix" 保持比例 -->
    <image 
      class="start-btn-img" 
      src="https://anglertest.xyz/game/startbtn.webp" 
      mode="widthFix"
    />
  </view>

  </view>
  
  <!-- 图鉴按钮 -->
  <view class="note-btn" bindtap="openFishCollection">
    <image class="note-icon" src="https://anglertest.xyz/game/note.webp" mode="aspectFit"></image>
  </view>
  
  <!-- 帮助提示弹窗 -->
  <view class="tips-modal" wx:if="{{showTips}}">
    <view class="tips-content">
      <view class="tips-header">
        <text class="tips-title">{{fishingHelp.title}}</text>
        <text class="close-btn" bindtap="toggleTips">×</text>
      </view>
      <scroll-view scroll-y="true" class="tips-body-scroll">
        <view class="tips-body">
  <view class="help-section" wx:for="{{fishingHelp.sections}}" wx:key="title">
    <view class="help-title">{{item.title}}</view>
    <view class="help-content">
      <block wx:if="{{isString(item.content)}}">
                      <!-- 将 text 标签替换为 view 标签 -->
                      <view>{{index == 0 ? item : item}}</view>
      </block>
      <block wx:else>
        <view wx:for="{{item.content}}" wx:for-item="contentItem" wx:key="*this" class="content-item">
                  <!-- 将 text 标签替换为 view 标签 -->
                  <view>{{contentItem}}</view> 
        </view>
      </block>
    </view>
  </view>
</view>
      </scroll-view>
    </view>
  </view>
</view>