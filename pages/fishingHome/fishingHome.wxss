/* pages/fishingHome/fishingHome.wxss */

/* 新增最底层背景层，解决不同设备显示问题 */
.background-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: url('https://anglertest.xyz/game/BG/tittle/14.webp') no-repeat center center;
    background-size: cover; /* 使用填充方式 */
    filter: blur(5px); /* 添加模糊效果 */
    z-index: -1; /* 置于最底层 */
}

.container {
    background: url('https://anglertest.xyz/game/BG/tittle/14.webp') no-repeat center center fixed;
    background-size: contain;
    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
    background-attachment: fixed;
    /* 添加边缘模糊效果 */
    box-shadow: inset 0 0 50px 20px rgba(0, 0, 0, 0.3);
}

/* 返回按钮样式 */
.back-btn {
    position: absolute;
    top: 100rpx;
    left: 5%;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    transition: background-color 0.3s;
}

.back-btn:hover {
    background-color: rgba(255, 255, 255, 0.5);
}

.container::before,
.container::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 20vh; /* 遮罩高度，可以根据需要调整 */
    z-index: 2;
}

.container::before {
    top: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
}

.container::after {
    bottom: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
}
.back-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
}

/* 帮助按钮样式 */
.help-btn {
    position: absolute;
    top: 200rpx;
    left: 5%;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    transition: background-color 0.3s;
}

.help-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
    font-style: italic;
}

/* 游戏标题样式 */
/* 图片标题样式 */
.logo-container {
  position: absolute;
  top: 10vh;
  left: 50%;
  transform: translateX(-50%); /* 确保水平居中 */
  z-index: 10;
  width: 100%; /* 添加宽度限制 */
  display: flex;
  justify-content: center; /* 水平居中 */
  animation: fadeInDown 1.5s ease-out forwards; /* 入场动画 */
}
/* 应用待机动画 */
.logo-container.animated {
  animation: floating 3s ease-in-out infinite;
}
.game-logo {
  width: 1000rpx; /* 减小宽度确保完整显示 */
  height: 1000rpx; /* 减小高度确保完整显示 */
  max-width: 100vw; /* 更小的最大宽度 */
  object-fit: contain; /* 确保图片完整显示 */
}

.title-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
}

/* 优化标题容器 */
.title-box {
    position: relative;
    border: none;
    /* 移除原边框 */
    box-shadow: 0 0 60rpx rgba(0, 255, 244, 0.3),
        0 0 120rpx rgba(0, 255, 244, 0.1);
    overflow: hidden;
    /* 配合光效层溢出隐藏 */
}
/* 包裹图片的容器，设置固定大小 */
.start-btn-wrapper {
    width: 360rpx; /* 固定宽度 */
    height: 130rpx; /* 固定高度 */
    display: flex;
    position: relative;
    justify-content: center;
    align-items: center;
    border-radius: 250rpx;
    overflow: hidden; /* 隐藏超出部分 */
    /* 添加脉冲动画 */
    /* animation: pulse 2s infinite;  */
    /* 添加悬停效果 */
    /* transition: all 0.3s ease; */
  }
  
  .start-btn-wrapper:active {
    transform: scale(0.95);
  }
/* 开始按钮图片样式 */

.start-btn-img {
    width: 100%; /* 宽度填满容器 */
    height: 100%; /* 高度填满容器 */
    object-fit: cover; /* 保持比例填充容器 */
    position: relative;
    overflow: hidden;
  }
  
  .start-btn-img:active {
    transform: scale(0.95);
  }

.start-btn-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
    animation: sweep 3s infinite;
    z-index: 1;
    pointer-events: none;
}

@keyframes sweep {
    0% {
        left: -100%;
    }
    50% {
        left: 100%;
    }
    100% {
        left: 100%;
    }
}

/* 开始按钮容器 */
.start-btn-container {
    position: absolute;
    bottom: 20%; /* 位于容器底部20%位置 */
    left: 50%;
    transform: translateX(-50%); /* 水平居中 */
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: center;
  }

.start-btn {
    background-color: #3a7734;
    color: white;
    font-size: 36rpx;
    font-weight: bold;
    padding: 20rpx 60rpx;
    border-radius: 50rpx;
    box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2);
    letter-spacing: 2rpx;
    margin-bottom: 30rpx;
    /* 应用脉冲动画 */
    animation: pulse 2s infinite; 
}
.start-btn:hover {
    transform: scale(1.05); /* 鼠标悬停时放大 */
    box-shadow: 0 10rpx 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(58, 119, 52, 0.7); /* 悬停时增强阴影和发光效果 */
}
.collection-btn {
    background: linear-gradient(45deg, #4a90e2, #63a6f5); /* 添加渐变背景 */
    color: white;
    font-size: 32rpx;
    font-weight: bold;
    padding: 15rpx 50rpx;
    border-radius: 50rpx;
    box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2), 0 0 20rpx rgba(74, 144, 226, 0.5); /* 添加阴影和发光效果 */
    letter-spacing: 2rpx;
    transition: all 0.3s ease; /* 添加过渡效果 */
}
.collection-btn:hover {
    transform: scale(1.05); /* 鼠标悬停时放大 */
    box-shadow: 0 10rpx 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(74, 144, 226, 0.7); /* 悬停时增强阴影和发光效果 */
}

/* 图鉴按钮样式 */
.note-btn {
    position: fixed;
    bottom: 100rpx;
    left: 5%;
    width: 100rpx;
    height: 20%;
    z-index: 100;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0);

    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

/* .note-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3);
} */

.note-icon {
    width: 200rpx;
    height: 200rpx;
}
/* 帮助提示弹窗内容样式优化 */
.tips-content {
    width: 80%;
    background: linear-gradient(135deg, #f9f9f9, #e0e0e0); /* 添加渐变背景 */
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5), 0 0 40rpx rgba(255, 255, 255, 0.3); /* 添加阴影和发光效果 */
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.5s ease; /* 添加淡入动画 */
}
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}
@keyframes pulse {
    0% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }
    50% {
        transform: scale(1.05);
        box-shadow: 0 15rpx 25rpx rgba(0, 0, 0, 0.4);
    }
    100% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }
}


.btn-hover {
    background-color: rgba(0, 121, 107, 0.9);
    transform: scale(0.98);
}

/* 帮助提示弹窗样式 */
.tips-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.tips-content {
    width: 80%;
    background-color: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
}

.tips-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: linear-gradient(45deg, #017EA6, #069BBB); /* 添加渐变背景 */
    color: white;
    border-top-left-radius: 20rpx;
    border-top-right-radius: 20rpx;
}

.tips-title {
    font-size: 36rpx;
    font-weight: bold;
}


.close-btn {
    font-size: 40rpx;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
}
.close-btn:hover {
    color: #ff5252; /* 鼠标悬停时改变颜色 */
}

.tips-body-scroll {
    max-height: 60vh;
    padding: 0 20rpx;
}

.tips-body {
    padding: 50rpx 50rpx 50rpx 30rpx;
    font-size: 28rpx;
    color: #333;
    line-height: 1.5;
    white-space: normal; /* 设置文本正常换行 */
    word-break: break-word; /* 允许在单词内换行 */
}


.help-section {
    margin-bottom: 30rpx;
}

.help-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #0066cc;
    margin-bottom: 15rpx;
}

.help-content {
    font-size: 28rpx;
    color: #333;
    line-height: 1.6;
    text-align: left;
    white-space: normal; /* 设置文本正常换行 */
    word-break: break-word; /* 允许在单词内换行 */
}

.content-item {
    margin-bottom: 10rpx;
    display: block;
    text-align: left;
    word-wrap: break-word;
    word-break: normal;
    white-space: normal;
    width: 100%;
}

.help-content {
    white-space: pre-wrap;
    word-break: break-all;
}

/* 添加段落标题样式 */

.help-content text {
    display: inline; /* 修改为内联元素，避免换行 */
    margin-top: 10rpx;
    margin-bottom: 10rpx;
    font-weight: bold;
    color: #009688;
    word-wrap: break-word;
    word-break: normal;
    width: 100%;
}

/* 添加上下安全区域 */
.tips-body::before,
.tips-body::after {
    content: '';
    display: block;
    height: 20rpx;
}
/* 添加关键帧动画 */
@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
  100% { transform: translateY(0); }
}

/* 添加待机动画类 */
.idle-animation {
  animation: float 3s ease-in-out infinite;
}
/* 添加关键帧动画 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-100px) scale(0.8);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}


/* 修改待机动画 */
@keyframes floating {
  0% {
    transform: translateX(-50%) translateY(0);
  }
  50% {
    transform: translateX(-50%) translateY(-15rpx);
  }
  100% {
    transform: translateX(-50%) translateY(0);
  }
}