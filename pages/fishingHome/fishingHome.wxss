/* pages/fishingHome/fishingHome.wxss */

.container {
    background: url('/images/icons/BG.webp') no-repeat center center fixed;
    background-size: cover;

    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
    background-attachment: fixed;



}

/* 返回按钮样式 */
.back-btn {
    position: absolute;
    top: 100rpx;
    left: 40rpx;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.back-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
}

/* 帮助按钮样式 */
.help-btn {
    position: absolute;
    top: 200rpx;
    left: 40rpx;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.help-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
    font-style: italic;
}

/* 游戏标题样式 */
.title-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
}

/* 优化标题容器 */
.title-box {
    position: relative;
    border: none;
    /* 移除原边框 */
    box-shadow: 0 0 60rpx rgba(0, 255, 244, 0.3),
        0 0 120rpx rgba(0, 255, 244, 0.1);
    overflow: hidden;
    /* 配合光效层溢出隐藏 */
}

/* 优化标题文字效果 */
.title {
    font-size: 42rpx;
    color: #ffffff;
    font-weight: 700;
    position: relative;
    z-index: 1;
    text-shadow: 0 4rpx 8rpx rgba(30, 58, 138, 0.5);
    letter-spacing: 1rpx;
    background: linear-gradient(45deg, #fff, #E6F0FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.game-title {
    font-size: 100rpx;
    font-weight: 900;
    letter-spacing: 12rpx;
    text-transform: uppercase;
    /* 全大写增强科技感 */
    background: linear-gradient(135deg, #00FFFF, #00BFFF, #40E0D0);
    /* 青蓝渐变 */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow:
        0 0 20rpx rgba(0, 255, 244, 0.8),
        /* 高频发光 */
        0 0 40rpx rgba(0, 255, 244, 0.5),
        0 0 80rpx rgba(0, 255, 244, 0.3),
        0 0 120rpx rgba(0, 255, 244, 0.1);
    position: relative;
    z-index: 2;
    /* 确保文字在光效层上方 */
}

.version {
    font-size: 36rpx;
    color: #87FFEB;
    text-shadow: 0 0 16rpx rgba(135, 255, 235, 0.6);
    letter-spacing: 4rpx;
    font-family: 'Courier New', monospace;
    /* 等宽字体增强科技感 */
}

/* 开始按钮样式 */
.start-btn-container {
    position: absolute;
    bottom: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    text-align: center;
}

.start-btn {
    background-color: #3a7734;
    color: white;
    font-size: 36rpx;
    font-weight: bold;
    padding: 20rpx 60rpx;
    border-radius: 50rpx;
    box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2);
    letter-spacing: 2rpx;
    margin-bottom: 30rpx;
}

.collection-btn {
  background-color: #4a90e2;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  padding: 15rpx 50rpx;
  border-radius: 50rpx;
  box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

@keyframes pulse {
    0% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }

    50% {
        transform: scale(1.05);
        box-shadow: 0 15rpx 25rpx rgba(0, 0, 0, 0.4);
    }

    100% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }
}

.btn-hover {
    background-color: rgba(0, 121, 107, 0.9);
    transform: scale(0.98);
}

/* 帮助提示弹窗样式 */
.tips-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.tips-content {
    width: 80%;
    background-color: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}

.tips-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background-color: #009688;
    color: white;
}

.tips-title {
    font-size: 36rpx;
    font-weight: bold;
}

.close-btn {
    font-size: 40rpx;
    font-weight: bold;
}

.tips-body {
    padding: 40rpx;
    font-size: 32rpx;
    line-height: 1.6;
    color: #333;
}