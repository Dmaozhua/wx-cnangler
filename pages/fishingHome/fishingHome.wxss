/* pages/fishingHome/fishingHome.wxss */

.container {
    background: url('/images/icons/BG.webp') no-repeat center center fixed;
    background-size: cover;

    width: 100%;
    height: 100vh;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 1;
    background-attachment: fixed;



}

/* 返回按钮样式 */
.back-btn {
    position: absolute;
    top: 100rpx;
    left: 40rpx;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.back-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
}

/* 帮助按钮样式 */
.help-btn {
    position: absolute;
    top: 200rpx;
    left: 40rpx;
    width: 80rpx;
    height: 80rpx;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
}

.help-icon {
    font-size: 40rpx;
    color: white;
    font-weight: bold;
    font-style: italic;
}

/* 游戏标题样式 */
.title-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
}

/* 优化标题容器 */
.title-box {
    position: relative;
    border: none;
    /* 移除原边框 */
    box-shadow: 0 0 60rpx rgba(0, 255, 244, 0.3),
        0 0 120rpx rgba(0, 255, 244, 0.1);
    overflow: hidden;
    /* 配合光效层溢出隐藏 */
}

/* 优化标题文字效果 */
.title {
    font-size: 42rpx;
    color: #ffffff;
    font-weight: 700;
    position: relative;
    z-index: 1;
    text-shadow: 0 4rpx 8rpx rgba(30, 58, 138, 0.5);
    letter-spacing: 1rpx;
    background: linear-gradient(45deg, #fff, #E6F0FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.game-title {
    font-size: 100rpx;
    font-weight: 900;
    letter-spacing: 12rpx;
    text-transform: uppercase;
    /* 全大写增强科技感 */
    background: linear-gradient(135deg, #00FFFF, #00BFFF, #40E0D0);
    /* 青蓝渐变 */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow:
        0 0 20rpx rgba(0, 255, 244, 0.8),
        /* 高频发光 */
        0 0 40rpx rgba(0, 255, 244, 0.5),
        0 0 80rpx rgba(0, 255, 244, 0.3),
        0 0 120rpx rgba(0, 255, 244, 0.1);
    position: relative;
    z-index: 2;
    /* 确保文字在光效层上方 */
}

.version {
    font-size: 36rpx;
    color: #87FFEB;
    text-shadow: 0 0 16rpx rgba(135, 255, 235, 0.6);
    letter-spacing: 4rpx;
    font-family: 'Courier New', monospace;
    /* 等宽字体增强科技感 */
}

/* 开始按钮样式 */
/* 开始按钮容器样式优化 */
.start-btn-container {
    position: absolute;
    bottom: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.start-btn {
    background-color: #3a7734;
    color: white;
    font-size: 36rpx;
    font-weight: bold;
    padding: 20rpx 60rpx;
    border-radius: 50rpx;
    box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2);
    letter-spacing: 2rpx;
    margin-bottom: 30rpx;
    /* 应用脉冲动画 */
    animation: pulse 2s infinite; 
}
.start-btn:hover {
    transform: scale(1.05); /* 鼠标悬停时放大 */
    box-shadow: 0 10rpx 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(58, 119, 52, 0.7); /* 悬停时增强阴影和发光效果 */
}
.collection-btn {
    background: linear-gradient(45deg, #4a90e2, #63a6f5); /* 添加渐变背景 */
    color: white;
    font-size: 32rpx;
    font-weight: bold;
    padding: 15rpx 50rpx;
    border-radius: 50rpx;
    box-shadow: 0 6rpx 10rpx rgba(0, 0, 0, 0.2), 0 0 20rpx rgba(74, 144, 226, 0.5); /* 添加阴影和发光效果 */
    letter-spacing: 2rpx;
    transition: all 0.3s ease; /* 添加过渡效果 */
}
.collection-btn:hover {
    transform: scale(1.05); /* 鼠标悬停时放大 */
    box-shadow: 0 10rpx 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(74, 144, 226, 0.7); /* 悬停时增强阴影和发光效果 */
}
/* 帮助提示弹窗内容样式优化 */
.tips-content {
    width: 80%;
    background: linear-gradient(135deg, #f9f9f9, #e0e0e0); /* 添加渐变背景 */
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5), 0 0 40rpx rgba(255, 255, 255, 0.3); /* 添加阴影和发光效果 */
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.5s ease; /* 添加淡入动画 */
}
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}
@keyframes pulse {
    0% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }
    50% {
        transform: scale(1.05);
        box-shadow: 0 15rpx 25rpx rgba(0, 0, 0, 0.4);
    }
    100% {
        transform: scale(1);
        box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.3);
    }
}


.btn-hover {
    background-color: rgba(0, 121, 107, 0.9);
    transform: scale(0.98);
}

/* 帮助提示弹窗样式 */
.tips-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.tips-content {
    width: 80%;
    background-color: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
}

.tips-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: linear-gradient(45deg, #009688, #00bfa5); /* 添加渐变背景 */
    color: white;
    border-top-left-radius: 20rpx;
    border-top-right-radius: 20rpx;
}

.tips-title {
    font-size: 36rpx;
    font-weight: bold;
}


.close-btn {
    font-size: 40rpx;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
}
.close-btn:hover {
    color: #ff5252; /* 鼠标悬停时改变颜色 */
}

.tips-body-scroll {
    max-height: 60vh;
    padding: 0 20rpx;
}

.tips-body {
    padding: 20rpx 30rpx 40rpx 30rpx;
    font-size: 28rpx;
    color: #333;
    line-height: 1.5;
    white-space: normal; /* 设置文本正常换行 */
    word-break: break-word; /* 允许在单词内换行 */
}


.help-section {
    margin-bottom: 30rpx;
}

.help-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #0066cc;
    margin-bottom: 15rpx;
}

.help-content {
    font-size: 28rpx;
    color: #333;
    line-height: 1.6;
    text-align: left;
    white-space: normal; /* 设置文本正常换行 */
    word-break: break-word; /* 允许在单词内换行 */
}

.content-item {
    margin-bottom: 10rpx;
    display: block;
    text-align: left;
    word-wrap: break-word;
    word-break: normal;
    white-space: normal;
    width: 100%;
}

.help-content {
    white-space: pre-wrap;
    word-break: break-all;
}

/* 添加段落标题样式 */

.help-content text {
    display: inline; /* 修改为内联元素，避免换行 */
    margin-top: 10rpx;
    margin-bottom: 10rpx;
    font-weight: bold;
    color: #009688;
    word-wrap: break-word;
    word-break: normal;
    width: 100%;
}

/* 添加上下安全区域 */
.tips-body::before,
.tips-body::after {
    content: '';
    display: block;
    height: 20rpx;
}