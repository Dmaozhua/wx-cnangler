/* pages/result/result.wxss */
/* 添加背景图 */
.container {
    padding: 20rpx;
    background-image: url('path/to/your/background-image.jpg'); /* 替换为实际背景图路径 */
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    box-sizing: border-box;
    padding-top: 120rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: fadeIn 1s ease-in-out; /* 添加淡入动画 */
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .result-card {
    background-color: rgba(255, 255, 255, 0.9); /* 半透明背景 */
    border-radius: 12rpx;
    padding: 40rpx 30rpx;
    width: 85%;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    margin-bottom: 40rpx;
    animation: slideUp 0.8s ease-in-out; /* 添加向上滑动动画 */
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  
  .result-header {
    text-align: center;
    margin-bottom: 40rpx;
  }
  
  .result-title {
    font-size: 48rpx;
    font-weight: bold;
    color: #FFD700; /* 金色标题 */
    display: block;
    margin-bottom: 10rpx;
    text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .result-subtitle {
    font-size: 32rpx;
    color: #fff;
    display: block;
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .result-stats {
    display: flex;
    justify-content: space-around;
    margin-bottom: 40rpx;
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: scaleIn 0.6s ease-in-out; /* 添加缩放动画 */
  }
  
  @keyframes scaleIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  
  .stat-value {
    font-size: 60rpx;
    font-weight: bold;
    color: #FF4500; /* 橙色数值 */
    margin-bottom: 10rpx;
    text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .stat-label {
    font-size: 30rpx;
    color: #fff;
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .fishing-info {
    display: flex;
    justify-content: center;
    margin-bottom: 20rpx;
  }
  
  .info-item {
    margin: 0 20rpx;
  }
  
  .info-label {
    font-size: 30rpx;
    color: #fff;
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .info-value {
    font-size: 30rpx;
    color: #FFD700; /* 金色数值 */
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .result-message {
    text-align: center;
    font-size: 36rpx;
    color: #fff;
    padding: 20rpx 0;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .restart-btn {
    background-color: #FF4500; /* 橙色按钮 */
    color: white;
    font-size: 36rpx;
    padding: 20rpx 0;
    border-radius: 50rpx;
    width: 80%;
    font-weight: bold;
    box-shadow: 0 4rpx 12rpx rgba(255, 69, 0, 0.3);
    margin-bottom: 20rpx;
    transition: all 0.3s ease-in-out; /* 添加过渡效果 */
  }
  
  .restart-btn:hover {
    background-color: #FF6347; /* 鼠标悬停时颜色变深 */
    transform: scale(1.05); /* 鼠标悬停时放大 */
  }
  
  .btn-hover {
    opacity: 0.8;
    transform: scale(0.98);
  }