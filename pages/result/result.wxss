/* pages/result/result.wxss */
/* 添加背景图 */
.container {
    padding: 20rpx;
    background-image: url('https://anglertest.xyz/game/BG/tittle/15.webp'); /* 替换为实际背景图路径 */
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    box-sizing: border-box;
    padding-top: 120rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation: fadeIn 1s ease-in-out; /* 添加淡入动画 */
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .result-card-container {
    width: 85%;
    margin-bottom: 40rpx;
    animation: slideUp 0.8s ease-in-out; /* 添加向上滑动动画 */
  }

  .result-card-container neo-card {
    padding: 40rpx 30rpx;
  }
  
  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  

  
  .result-stats {
    display: flex;
    justify-content: space-around;
    margin-bottom: 40rpx;
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: scaleIn 0.6s ease-in-out; /* 添加缩放动画 */
  }
  
  @keyframes scaleIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  
  .stat-value {
    font-size: 60rpx;
    font-weight: bold;
    color: #FF4500; /* 橙色数值 */
    margin-bottom: 10rpx;
    text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .stat-label {
    font-size: 30rpx;
    color: #fff;
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .fishing-info {
    display: flex;
    justify-content: center;
    margin-bottom: 20rpx;
  }
  
  .info-item {
    margin: 0 20rpx;
  }
  
  .info-label {
    font-size: 30rpx;
    color: #fff;
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .info-value {
    font-size: 30rpx;
    color: #FFD700; /* 金色数值 */
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }
  
  .result-message {
    text-align: center;
    font-size: 36rpx;
    color: #fff;
    padding: 20rpx 0;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    text-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.5); /* 添加文字阴影 */
  }

  .restart-btn-container {
    padding: 20rpx 60rpx;  /* 上下内边距20rpx，左右60rpx */
    font-size: 32rpx;      /* 字体大小同步调整 */
    transform: scale(1.2);  /* 放大1.2倍，1.0为原始大小 */
    transform-origin: center; /* 缩放中心点 */
  }