/* pages/result/result.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.result-card {
  background-color: white;
  border-radius: 12rpx;
  padding: 40rpx 30rpx;
  width: 85%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1E3A8A;
  display: block;
  margin-bottom: 10rpx;
}

.result-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
}

.result-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1E3A8A;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
}

.result-message {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx 0;
  border-top: 1px solid #eee;
}

.restart-btn {
  background-color: #1E3A8A;
  color: white;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-radius: 50rpx;
  width: 80%;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.3);
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}