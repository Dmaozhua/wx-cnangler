<!-- 自定义导航栏 -->
<page-meta>
    <navigation-bar id="navigation-bar" title="钓鱼人测试" background="#BDC3C7" color="#000000" back="{{false}}" style="transition: background 0.3s ease, color 0.3s ease;"></navigation-bar>
</page-meta>

<view class="page-container" style="background: {{containerStyle}};">
    <view wx:if="{{showPrompt}}" class="first-tip">
        <text class="icon-huanying1 iconfont topicon"></text>
        <text class="huanyingtips">欢迎使用钓鱼人测试!</text>
        <image src="/images/tab/鱼钩 (1).png" class="close-btn" bindtap="closePrompt" />
    </view>
    <!-- 提示信息 -->
    <view class="tips" wx:if="{{showTips}}">
        <text>{{tipsText}}</text>
    </view>
    <scroll-view class="container" scroll-y="true" show-scrollbar="false" bindtouchmove="touchMove">
        <!-- 添加用于颜色分析的隐藏canvas -->
        <canvas canvas-id="colorAnalyzerCanvas" id="colorAnalyzerCanvas" style="width: 100px; height: 100px; position: absolute; left: -1000px; visibility: hidden;" type="2d"></canvas>
        <!-- 成就弹窗组件 -->
        <achievement-popup wx:if="{{achievementPopupVisible}}" visible="{{achievementPopupVisible}}" achievement="{{currentAchievement}}" achievements="{{pendingAchievements}}" currentIndex="{{currentAchievementIndex}}" bindclose="onCloseAchievementPopup" bindviewdetails="onViewAchievementDetails" bindswitchAchievement="onSwitchAchievement" />

        <!-- 天气弹窗组件 -->
        <weather-modal wx:if="{{weatherModalVisible}}" visible="{{weatherModalVisible}}" cityName="{{weatherCityName}}" weatherData="{{weatherData}}" pressure="{{weatherPressure}}" sunsetTime="{{weatherSunsetTime}}" bindclose="closeWeatherModal" />

        <view class="welcome-card" style="background: {{welcomeCardStyle}}; transition: background 0.3s ease-in-out;">
        <view class="welcome" style="color: {{welcomeTextColor}}; transition: color 0.3s ease-in-out;">🎣 欢迎来到 钓鱼人测试！🎣</view>
        <view class="welcome-subtitle" style="color: {{welcomeTextColor}}; opacity: 0.9; transition: color 0.3s ease-in-out;">这里是专业的路亚钓鱼频道</view>
    </view>

        <swiper class="banner-swiper" indicator-dots="true" autoplay="true" interval="3000" bindchange="onSwiperChange" circular="true">
            <swiper-item wx:for="{{bannerList}}" wx:key="index">
                <view catch:tap="onBannerTap" data-index="{{index}}" style="width:100%;height:100%;">
                    <image src="{{item.webpUrl || item.imageUrl}}" mode="aspectFill" class="banner-image" binderror="onImageError" data-index="{{index}}" />
                </view>
            </swiper-item>
        </swiper>

        <view class="test-section bordered">

            <view class="section-title" style="color: {{sectionTitleStyle.testTitle}}; transition: color 0.3s ease-in-out; display: flex; align-items: center;">
                <image src="../../images/icons/homeicon1.png" class="title-icon" />
                <text>钓鱼人性格测试</text> <!-- 拆分文字为独立标签，避免文本流影响 -->
            </view>

            <text class="section-subtitle">了解你的钓鱼风格</text>
            <view class="test-grid test-grid-2x2">
                <view class="top-row">
                    <button class="test-btn" hover-class="btn-hover" bindtap="goToTest1">钓鱼人性格测试</button>
                    <button class="test-btn random-test-btn" hover-class="btn-hover" bindtap="goToRandomTest"><text class="random-icon">🎲</text>随机测试</button>
                </view>
                <button class="test-btn test-more-btn" hover-class="btn-hover" bindtap="goToAllTests">查看全部测试 ({{testCount}})<text class="arrow-icon">></text></button>
            </view>
        </view>

        <!-- <view class="gear-section bordered">
        <view class="section-header">
            <text class="section-title gear-title" style="color: {{sectionTitleStyle.gearTitle}}; transition: color 0.3s ease-in-out;">⚔️ 测试你的本命装备</text>
            <text class="section-subtitle">找到最适合你的钓具</text>
        </view>
        <view class="gear-grid  test-grid-2x2">
            <button class="gear-btn" hover-class="btn-hover" bindtap="goToGearTest1">钓竿推荐-新手向</button>
            <button class="gear-btn" hover-class="btn-hover" bindtap="goToGearTest2">渔轮推荐-新手向</button>
            <button class="gear-btn" hover-class="btn-hover" bindtap="goToGearTest3">小众配件</button>
            <button class="gear-btn more-btn" hover-class="btn-hover" bindtap="onMoreBtnTap">展示更多 <text class="arrow-icon">⌄</text></button>
        </view> 
    </view>  -->

        <view class="features-section bordered">


            <view class="section-title" style="color: {{sectionTitleStyle.testTitle}}; transition: color 0.3s ease-in-out; display: flex; align-items: center;">
                <image src="../../images/icons/homeicon5.png" class="title-icon" />
                <text>实用功能</text> <!-- 拆分文字为独立标签，避免文本流影响 -->
            </view>


            <text class="section-subtitle">提升你的钓鱼体验</text>
            <view class="features-grid">
                <button class="feature-btn music-btn" hover-class="btn-hover" bindtap="goTomusic">
                    <image class="feature-icon music-icon" src="../../images/icons/homeicon4.png"></image>
                路亚音乐</button>
                <!-- <button class="feature-btn equipment-btn" hover-class="btn-hover" bindtap="goToEquipment">装备图鉴</button> -->
                <button class="feature-btn weather-btn" hover-class="btn-hover" bindtap="checkWeather">
                    <image class="feature-icon music-icon" src="../../images/icons/homeicon8.png"></image>
                今日天气</button>
                <button class="feature-btn simulator-btn" hover-class="btn-hover" bindtap="goToFishingSimulator">
                    <image class="feature-icon music-icon" src="../../images/icons/homeicon15.png"></image>
                钓鱼模拟器</button>
                <button class="feature-btn test-btn" hover-class="btn-hover" bindtap="goToDonghuaTest">
                    <image class="feature-icon music-icon" src="../../images/icons/homeicon16.png"></image>
                动画测试</button>
            </view>
        </view>
    </scroll-view>
</view>