/* pages/achievements/achievements.wxss */

/* 自定义导航栏样式 */
.custom-nav-bar .weui-navigation-bar__inner {
    z-index: 1000;
    --height: 60px; /* 增加导航栏高度 */
    background: linear-gradient(to right, #2c3e50, #34495e); /* 渐变背景 */
    color: white; /* 文字颜色 */
}

.page-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  z-index: 1;
  background-color: #ecf0f1; /* 页面背景颜色 */
}

.achievement-container {
    padding: 20rpx;
    background: #f5f7fa;
    position: absolute;
    top: 200rpx; /* 调整顶部位置 */
    left: 0;
    right: 0;
    bottom: 0;
    box-sizing: border-box;
    border-radius: 20rpx; /* 圆角 */
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1); /* 阴影 */
}


/* 标题栏 */
.title-bar {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 0 20rpx; /* 内边距 */
}
.title-icon {
    width: 80rpx;
    height: 80rpx;
    margin-right: 20rpx;
    animation: spin 5s linear infinite; /* 旋转动画 */
}
@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.title-text {
  font-size: 32rpx;
  color: #2E4053;
  font-weight: 600;
  margin-right: auto;
}
.score-text {
  font-size: 28rpx;
  color:  #8ab6d3;
  font-weight: 600;
  background: rgba(72, 201, 176, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 分类导航 */
.category-nav {
    white-space: nowrap;
    margin-bottom: 40rpx;
    padding: 0 20rpx; /* 内边距 */
}
.nav-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  background: #e0e6ed;
  color: #666;
  transition: all 0.3s;
}
.nav-item.active {
    background: #3498db;
    color: white;
    box-shadow: 0 5rpx 15rpx rgba(52, 152, 219, 0.3); /* 阴影 */
}

/* 成就列表容器 */
.achievement-list-container {
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx; /* 确保底部有足够空间 */
}

/* 成就卡片 */
.achievement-card {
  background: white;
  border-radius: 24rpx;
  margin: 0 20rpx 30rpx 20rpx;
  padding: 30rpx;
  display: flex;
  opacity: 0.7;
  transition: all 0.3s ease;
  border: 2rpx solid #eaeaea;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.achievement-card.locked {
  opacity: 0.5;
}

.achievement-card.locked .detail-box {
  filter: blur(1px);
}

.achievement-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: #e0e6ed;
  transition: all 0.3s ease;
}

.achievement-card.unlocked {
  opacity: 1;
  box-shadow: 0 10rpx 30rpx rgba(72,201,176,0.15);
  border: 2rpx solid rgba(72,201,176,0.3);
  transform: translateY(-4rpx);
}

.achievement-card.unlocked::before {
  background:  #8ab6d3;
}

.achievement-card:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 15rpx rgba(72,201,176,0.1);
}

/* 图标盒子 */
.icon-box {
  width: 100rpx;
  height: 100rpx;
  margin-right: 30rpx;
  position: relative;
}

.achievement-icon {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f5f7fa;
  object-fit: cover;
}

.sparkle-effect {
  position: absolute;
  width: 150%;
  height: 150%;
  top: -25%;
  left: -25%;
  z-index: 1;
  pointer-events: none;
}

/* 详情盒子 */
.detail-box {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.achievement-title {
  font-size: 32rpx;
  color: #2E4053;
  font-weight: 600;
  margin-bottom: 10rpx;
  
}

.achievement-desc {
  font-size: 26rpx;
  color: #7F8C8D;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* 进度条 */
.progress-bar {
  height: 20rpx;
  background: #e0e6ed;
  border-radius: 10rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg,  #8ab6d3,rgb(72, 100, 182));
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.progress-text {
  position: absolute;
  right: 10rpx;
  top: 0;
  font-size: 20rpx;
  color: #fff;
  line-height: 20rpx;
  text-shadow: 0 0 2rpx rgba(0,0,0,0.3);
}

/* 奖励标识 */
.reward-badge {
  display: flex;
  align-items: center;
  background: rgba(72, 201, 176, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 30rpx;
  align-self: flex-start;
}

.gift-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.reward-text {
  font-size: 24rpx;
  color:  #8ab6d3;
}

/* 弹窗样式会由组件提供 */
.new-achievement-toast {
  position: fixed;
  bottom: 100rpx;
  left: 5%;
  width: 90%;
  background: rgba(72,201,176,0.95);
  color: white;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  animation: float 1.5s infinite;
}

@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
  100% { transform: translateY(0); }
}

/* 成就标题和描述 */
.achievement-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
  line-height: 1.4;
}

.achievement-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.5;
}

/* 奖励标识 */
.reward-badge {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.gift-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.reward-text {
  font-size: 24rpx;
  color:  #8ab6d3;
}

/* 成就列表容器 */
.achievement-list {
  height: calc(100vh - 220rpx);
  padding: 20rpx 0;
  box-sizing: border-box;
}

/* 详情容器 */
.detail-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
