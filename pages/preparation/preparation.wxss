/* pages/preparation/preparation.wxss */
page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden; /* 防止页面滚动 */
}

/* 背景图专用容器 */
.scene-bg-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1; /* 确保在最底层 */
  background-color: rgba(0, 0, 0, 0.3);
}

.scene-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  object-fit: cover; /* 确保图片覆盖整个容器且不变形 */
  transition: opacity 0.5s ease; /* 添加过渡效果 */
}

/* 背景淡出动画 */
.scene-bg-fade-out {
  opacity: 0;
}

/* 背景淡入动画 */
.scene-bg-fade-in {
  opacity: 1;
}

.container {
  padding: 12rpx;
  background-color: transparent; /* 移除背景色，使背景图可见 */
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 90rpx;
  position: relative;
  z-index: 1; /* 确保内容在背景之上 */
  display: flex;
  flex-direction: column;
}

/* 返回按钮样式 */
.back-btn {
  position: absolute;
  top: 90rpx;
  left: 30rpx;
  width: 70rpx;
  height: 70rpx;
  background-color: rgba(109, 170, 235, 0.3);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.back-icon {
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.back-text {
  font-size: 28rpx;
}

.header {
  margin-bottom: 15rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1E3A8A;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
}

.info-card {
  background-color: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  padding: 12rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(30, 58, 138, 0.1);
  backdrop-filter: blur(5px);
  transition: all 0.3s ease;
}

.info-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.2);
}

/* 卡片网格布局 */
.cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 两列布局 */
  gap: 8rpx;
  margin-bottom: 4rpx;
}

/* 天气卡片特殊样式 */
.weather-card {
  background: linear-gradient(to right, rgba(255, 255, 255, 0.9), rgba(209, 233, 255, 0.85));
  grid-column: 1;
}

/* 水域卡片特殊样式 */
.water-card {
  background: linear-gradient(to right, rgba(255, 255, 255, 0.9), rgba(209, 255, 236, 0.85));
  grid-column: 2;
}

/* 栖息地卡片特殊样式 */
.habitat-card {
  background: linear-gradient(to right, rgba(255, 255, 255, 0.9), rgba(255, 245, 209, 0.85));
  grid-column: 1 / span 2; /* 横跨两列 */
}

/* 自定义radio样式 */
.habitat-option radio {
  transform: scale(0.8);
}

/* 选中状态的样式增强 */
.habitat-option radio[checked] + .habitat-name {
  color: #1E3A8A;
  font-weight: bold;
}

/* 为选中状态添加类，在WXML中通过条件添加 */
.habitat-option-selected {
  background-color: rgba(30, 58, 138, 0.15);
  box-shadow: 0 3rpx 12rpx rgba(30, 58, 138, 0.25);
  border: 2rpx solid #1E3A8A;
  transform: scale(1.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E3A8A;
  margin-bottom: 6rpx;
  border-bottom: 2rpx solid rgba(30, 58, 138, 0.2);
  padding-bottom: 4rpx;
  text-align: center;
  position: relative;
}

.card-title::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 3rpx;
  background-color: #1E3A8A;
  border-radius: 3rpx;
}

.weather-info, .water-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 10rpx;
}

.weather-name, .water-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #1E3A8A;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.weather-desc, .water-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.4;
  max-width: 90%;
}

.water-image {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  margin-top: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  object-fit: cover;
  transition: transform 0.3s ease;
}

.water-image:hover {
  transform: scale(1.02);
}

.habitat-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin: 8rpx 0;
}

.habitat-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 12rpx;
  margin: 2rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
}

.habitat-option:hover,
.habitat-option:active {
  background-color: rgba(30, 58, 138, 0.1);
  transform: scale(1.02);
}

.habitat-name {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.button-group {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 90%;
  margin: 80rpx auto;
  gap: 12rpx;
}

.random-btn {
  background-color: #4B5563;
  color: white;
  font-size: 28rpx;
  padding: 15rpx 0;
  border-radius: 50rpx;
  width: 48%;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(75, 85, 99, 0.3);
  transition: all 0.3s ease; /* 添加过渡效果 */
}

/* 随机按钮禁用状态 */
.random-btn[disabled] {
  background-color: #9CA3AF;
  opacity: 0.7;
  box-shadow: none;
  color: rgba(255, 255, 255, 0.8);
}

.start-btn {
  background-color: #1E3A8A;
  color: white;
  font-size: 28rpx;
  padding: 15rpx 0;
  border-radius: 50rpx;
  width: 48%;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.3);
  position: relative;
  overflow: hidden;
  animation: pulse 1.5s infinite alternate;
}

.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 按钮动效 - 呼吸效果 */
@keyframes pulse {
  0% {
    box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.3);
    transform: scale(1);
  }
  100% {
    box-shadow: 0 4rpx 20rpx rgba(30, 58, 138, 0.7);
    transform: scale(1.03);
  }
}

/* 按钮扫光效果 */
.start-btn::after {
  content: '';
  position: absolute;
  top: -300%;
  left: -50%;
  width: 300%;
  height: 300%;
  background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 50%, rgba(255, 255, 255, 0) 100%);
  transform: rotate(30deg);
  animation: sweep 3s infinite linear;
  pointer-events: none;
}

@keyframes sweep {
  0% {
    transform: rotate(30deg) translateX(-100%);
  }
  100% {
    transform: rotate(30deg) translateX(100%);
  }
}