<!--pages/preparation/preparation.wxml-->
<page-meta>
  <!-- 自定义导航栏 -->
  <navigation-bar title="钓鱼准备" background="#BDC3C7" color="#000000" back="{{true}}"></navigation-bar>
</page-meta>

<!-- 背景图容器 -->
<view class="scene-bg-container">
  <image class="scene-bg {{sceneBgFadeOut ? 'scene-bg-fade-out' : ''}} {{sceneBgFadeIn ? 'scene-bg-fade-in' : ''}}" src="{{water.image}}" mode="aspectFill"></image>
</view>

<view class="container">
  <!-- 返回主页按钮 -->
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap=  "goBack">
    <text class="back-icon">←</text>
  </view>
  
  <view class="header">
    <text class="title">钓鱼准备</text>
    <text class="subtitle">选择合适的钓点开始钓鱼</text>
  </view>

  <!-- 卡片网格布局 -->
  <view class="cards-grid">
    <!-- 天气信息 - 使用neo-card -->
    <view class="weather-card-container">
      <neo-card title="当前天气" 
                content="{{weather.name}} - {{weather.description}}"
                bg-color="rgba(209, 233, 255, 0.9)">
      </neo-card>
    </view>
    
    <!-- 水域信息 - 使用neo-card -->
    <view class="water-card-container">
      <neo-card title="钓场水域" 
                content="{{water.name}} - {{water.description}}"
                bg-color="rgba(209, 255, 236, 0.9)">
        <image class="water-image" src="{{water.image}}" mode="aspectFill"></image>
      </neo-card>
    </view>
  
    <!-- 栖息地选择 - 使用neo-tabs -->
    <view class="habitat-card-container">
      <neo-tabs tabs="{{habitatTabNames}}" 
                contents="{{habitatTabContents}}"
                active-index="{{selectedHabitatIndex}}"
                bg-color="rgba(255, 245, 209, 0.9)"
                active-color="#FFD166"
                bind:tabchange="onHabitatTabChange">
        <view slot="content-{{selectedHabitatIndex}}" class="habitat-selection">
          <radio-group bindchange="onHabitatChange">
            <label class="habitat-radio-option {{selectedHabitat === habitatsList[selectedHabitatIndex].key ? 'selected' : ''}}">
              <radio value="{{habitatsList[selectedHabitatIndex].key}}" 
                     checked="{{selectedHabitat === habitatsList[selectedHabitatIndex].key}}" 
                     color="#1E3A8A"/>
              <text class="habitat-radio-text">选择此钓点</text>
            </label>
          </radio-group>
        </view>
      </neo-tabs>
    </view>
  </view>
  
  <!-- 开始钓鱼按钮 -->
  <view class="button-group">
    <button class="random-btn" bindtap="onRandomAgain" hover-class="btn-hover" disabled="{{isRandomButtonDisabled}}">再次随机</button>
    <button class="start-btn" bindtap="onStart" hover-class="btn-hover">出发钓鱼</button>
  </view>
</view>