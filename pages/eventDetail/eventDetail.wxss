.effect-label,
.stats-label {
  color: #555;
  font-weight: 500;
  flex: 1;
}

.effect-value,
.stats-value {
  font-weight: 600;
  flex-shrink: 0;
}

/* 正负值的颜色 */
.effect-value {
  color: #4CAF50; /* 默认为正面效果的绿色 */
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  position: relative;
  padding-right: 10rpx;
}

.effect-value.negative {
  color: #F44336; /* 负面效果的红色 */
}

.effect-value::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: currentColor;
  opacity: 0.3;
  border-radius: 1rpx;
}