/* pages/eventDetail/eventDetail.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(to bottom, #1a4d2e, #2d6a4f);
  color: #e0f2e9;
  position: relative;
  overflow: hidden;
}

/* 水波纹背景效果 */
.water-ripple {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><path d="M0,50 Q25,40 50,50 T100,50 T150,50" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="2"/></svg>');
  background-size: 100px 100px;
  opacity: 0.3;
  z-index: 0;
  animation: ripple 10s linear infinite;
}

@keyframes ripple {
  0% { background-position: 0 0; }
  100% { background-position: 100px 0; }
}

.back-btn {
  position: absolute;
  left: 30rpx;
  top: 10%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  z-index: 10;
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: translateY(-50%) scale(0.9);
  background-color: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(to right, #1e5631, #3a7734);
  position: relative;
  height: 80rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  z-index: 10;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  margin-left: 60rpx; /* 为左侧返回按钮留出空间 */
}

.event-detail {
  flex: 1;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  width: 90%;
  margin: 30rpx auto;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.image-container {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  margin: 20rpx auto 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.event-image {
  width: 280rpx;
  height: 280rpx;
  display: block;
  filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.4));
  transition: transform 0.3s ease;
  animation: float 3s ease-in-out infinite;
  border-radius: 10rpx;
  z-index: 2;
}

.image-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(58, 119, 52, 0.3) 0%, rgba(58, 119, 52, 0) 70%);
  filter: blur(15rpx);
  z-index: 1;
  animation: pulse 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.1); }
}

.info-section {
  width: 100%;
  margin-bottom: 40rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.event-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a4d2e;
  margin-bottom: 10rpx;
  text-align: center;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.event-type-badge {
  display: inline-block;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(to right, #3a7734, #1a4d2e);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  margin: 0 auto 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.event-type-badge::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  animation: shine 3s infinite;
}

@keyframes shine {
  0% { left: -100%; }
  20% { left: 100%; }
  100% { left: 100%; }
}

.event-description {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  white-space: pre-wrap;
  text-align: center;
  padding: 0 10rpx;
  margin-top: 10rpx;
}

.effects-section,
.stats-section {
  width: 100%;
  margin-bottom: 30rpx;
  border-top: 2rpx solid rgba(26, 77, 46, 0.2);
  padding: 20rpx;
  box-sizing: border-box;
  position: relative;
}

.effects-section::before,
.stats-section::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 2rpx;
  background: linear-gradient(to right, transparent, rgba(26, 77, 46, 0.5), transparent);
}

.effects-title,
.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a4d2e;
  margin-bottom: 20rpx;
  text-align: center;
  position: relative;
  display: inline-block;
  width: 100%;
}

.effects-title::after,
.stats-title::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #3a7734;
  border-radius: 2rpx;
}

.effects-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.effect-item,
.stats-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  padding: 15rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.effect-item:hover,
.stats-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.effect-icon,
.stats-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
  border-radius: 50%;
  background-size: 60%;
  background-position: center;
  background-repeat: no-repeat;
  flex-shrink: 0;
}

