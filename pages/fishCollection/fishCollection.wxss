/* pages/fishCollection/fishCollection.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(to bottom, #1a4d2e, #2d6a4f);
  color: #e0f2e9;
  position: relative;
  overflow: hidden;
}

/* 动态海浪效果 */
.waves {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 20%;
  z-index: 0;
  overflow: hidden;
}

.wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 200%;
  height: 100%;
  background-repeat: repeat-x;
  background-position: bottom;
  transform-origin: center bottom;
}

.wave-1 {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="%2300a896"/></svg>');
  animation: wave 15s linear infinite;
  opacity: 0.8;
  z-index: 3;
}

.wave-2 {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".35" fill="%2300a896"/></svg>');
  animation: wave 12s linear -2s infinite;
  opacity: 0.6;
  z-index: 2;
}

.wave-3 {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" fill="%2300a896" opacity="0.4"/></svg>');
  animation: wave 18s linear -5s infinite;
  opacity: 0.5;
  z-index: 1;
}

@keyframes wave {
  0% {
    transform: translateX(0) translateZ(0) scaleY(1);
  }
  50% {
    transform: translateX(-25%) translateZ(0) scaleY(0.95);
  }
  100% {
    transform: translateX(-50%) translateZ(0) scaleY(1);
  }
}

/* 图鉴类型切换标签 */
.gallery-type-tabs {
  display: flex;
  width: 100%;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  width: calc(100% - 60rpx);
  z-index: 10;
}

.gallery-type-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.gallery-type-tab.active {
  color: #3a7bff;
  font-weight: bold;
}

.gallery-type-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 6rpx;
  background-color: #3a7bff;
  border-radius: 3rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(30, 86, 49, 0.85);
  height: 100rpx;
  color: rgb(255, 255, 255);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  z-index: 10;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  width: calc(100% - 60rpx);
}

.back-btn {
  position: absolute;
  left: 30rpx;
  top: 10%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  z-index: 10;
  transition: all 0.3s ease;
}

.back-btn:active {
  transform: translateY(-50%) scale(0.9);
  background-color: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.title {
  flex: 1;
  text-align: left;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(2, 2, 2, 0.3);
  margin-left: 0rpx;
}
.collection-container {
  display: flex;
  align-items: center;
}
.collection-info {
  font-size: 24rpx;
  color: #a0e4bc;
  background-color: rgba(0, 0, 0, 0.2);
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  margin-left: 12rpx;
}

/* 鱼类列表 */
.fish-list,
.event-list {
  flex: 1;
  padding: 20rpx;
  position: relative;
  z-index: 1;
  height: calc(100vh - 250rpx);
  overflow-y: auto;
}

.fish-grid,
.event-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.fish-item,
.event-item {
  width: calc(33.33% - 20rpx);
  margin-bottom: 30rpx;
  z-index: 5;
}

.fish-card,
.event-card {
  background-color: #fff;
  border-radius: 15rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.9);
}

.fish-image,
.event-image {
  width: 100%;
  height: 180rpx;
  background-color: #f0f0f0;
  object-fit: contain;
}

.fish-name,
.event-name {
  font-size: 26rpx;
  color: #333;
  padding: 10rpx 15rpx;
  text-align: center;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fish-rarity,
.event-type {
  font-size: 22rpx;
  padding: 5rpx 15rpx 15rpx;
  text-align: center;
  color: #999;
}

/* 稀有度颜色 */
.rarity-common {
  color: #b0b0b0;
}

.rarity-uncommon {
  color: #4caf50;
}

.rarity-rare {
  color: #2196f3;
}

.rarity-epic {
  color: #9c27b0;
}

.rarity-mythic {
  color: #ff9800;
  text-shadow: 0 0 5rpx rgba(255, 152, 0, 0.5);
}

.rarity-boss {
  color: #f44336;
  text-shadow: 0 0 5rpx rgba(244, 67, 54, 0.5);
}

.rarity-waste {
  color: #795548;
}

.locked .fish-card,
.locked .event-card {
  opacity: 0.7;
}

.lock-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  z-index: 2;
}

/* 标签分类过滤 */
.filter-tabs {
  padding: 10rpx 20rpx;
  background-color: rgba(0, 0, 0, 0.2);
  z-index: 5;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  position: relative;
}

.tabs-scroll {
  white-space: nowrap;
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.filter-tab {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 15rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background-color: #3a7734;
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 底部提示 */
.footer-tip {
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  color: rgba(255, 255, 255, 0.6);
  background-color: rgba(0, 0, 0, 0.2);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: 1;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  word-wrap: break-word;
  box-sizing: border-box;
  width: calc(100% - 60rpx);
  position: relative;
}