<!--components/fish-status/fish-status.wxml-->
<view class="fish-status-container {{isVisible ? 'visible' : 'hidden'}}" animation="{{animationData}}">
  <neo-card title="战斗状态" 
            bg-color="rgba(234, 234, 234, 0.95)"
            border-color="#1E3A8A"
            text-color="#333">
    <view class="status-content">
      <!-- 鱼的信息 -->
      <view class="fish-info" wx:if="{{currentFish}}">
        <view class="fish-name-container {{rarityBgClass}} {{rarityBorderClass}}">
          <text class="fish-name">
            <text class="char">？</text>
            <text class="char">？</text>
            <text class="char">？</text>
          </text>
        </view>

        <view class="progress-container">
          <view class="neo-progress">
            <view class="progress-bar fish-progress-inner" style="width: {{ (currentFish.hp / (currentFish.BaseHP * currentFish.strengthVal) * 100) <= 0 ? '0%' : (currentFish.hp / (currentFish.BaseHP * currentFish.strengthVal) * 100) + '%' }};"></view>
          </view>
          <!-- 血量标签和伤害动画同行显示 -->
          <view class="progress-label-row">
            <text class="progress-label">鱼儿血量</text>
            <view class="damage-animations-container">
              <view wx:for="{{damageAnimations}}" wx:key="id" class="damage-animation" animation="{{item.animationData}}">
                <text class="damage-text">{{item.damage}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 钓线状态 -->
      <view class="line-info">
        <view class="progress-container">
          <view class="neo-progress">
            <!-- 计算钓线状态百分比 -->
            <view class="progress-bar line-progress-inner" style="width: {{(playerHP / 150 * 100) + '%'}};"></view>
          </view>
          <!-- 钓线状态标签和伤害动画同行显示 -->
          <view class="progress-label-row">
            <text class="progress-label">钓线状态</text>
            <view class="line-damage-animations-container">
              <view wx:for="{{lineDamageAnimations}}" wx:key="id" class="damage-animation" animation="{{item.animationData}}">
                <text class=".damage-text1">{{item.damage}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- QTE状态提示 -->
      <view class="qte-status" wx:if="{{qteState}}" animation="{{qteAnimationData}}">
        <text class="qte-text">{{qteState}}</text>
      </view>
    </view>
  </neo-card>
</view>