/* components/fish-status/fish-status.wxss */
.fish-status-container {
  position: fixed;
  left: 0;
  top: 45%;
  transform: translateX(-100%) translateY(-50%);
  width: 600rpx;
  background-color: rgba(234, 234, 234, 0.9);
  border-radius: 0 16rpx 16rpx 0;
  box-shadow: 2rpx 2rpx 10rpx rgba(0, 0, 0, 0.2);
  padding: 20rpx;
  z-index: 100;
  transition: all 0.6s ease;
}

.visible {
  display: block;
}

.hidden {
  display: none;
}

.status-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fish-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.fish-name-container {
  padding: 15rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.fish-name {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  position: relative;
  z-index: 2;
}

/* 稀有度文字颜色 */
.rarity-1 {
    color: #888888; /* 灰色 */
    text-shadow: 0 0 5rpx rgba(136, 136, 136, 0.5);
  }
  
  .rarity-2 {
    color: #4CAF50; /* 绿色 */
    text-shadow: 0 0 5rpx rgba(76, 175, 80, 0.5);
  }
  
  .rarity-3 {
    color: #2196F3; /* 蓝色 */
    text-shadow: 0 0 5rpx rgba(33, 150, 243, 0.5);
  }
  
  .rarity-4 {
    color: #9C27B0; /* 紫色 */
    text-shadow: 0 0 5rpx rgba(156, 39, 176, 0.5);
  }
  
  .rarity-5 {
    color: #FFD700; /* 金色 */
    text-shadow: 0 0 5rpx rgba(255, 215, 0, 0.5);
  }

/* 稀有度背景样式 */
.rarity-bg-1 {
  background-color: #f0f0f0; /* 静态灰色矩形 */
}

.rarity-bg-2 {
  background-color: #e8f5e9;
  position: relative;
  overflow: hidden;
}

.rarity-bg-2::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 200%;
  height: 100%;
  background: repeating-linear-gradient(45deg, transparent, transparent 10rpx, rgba(76, 175, 80, 0.2) 10rpx, rgba(76, 175, 80, 0.2) 20rpx);
  animation: stripe-animation 11s linear infinite;
  z-index: 1;
}

.rarity-bg-3 {
  background-color: #e3f2fd;
  position: relative;
  overflow: hidden;
}

.rarity-bg-3::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 300%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(33, 150, 243, 0.3), transparent);
  animation: wave-animation 3s ease-in-out infinite;
  z-index: 1;
}

.rarity-bg-4 {
  background-color: #f3e5f5;
  position: relative;
  overflow: hidden;
}

.rarity-bg-4::before {
  content: "";
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: radial-gradient(circle, rgba(156, 39, 176, 0.1) 10%, rgba(156, 39, 176, 0.3) 40%, rgba(156, 39, 176, 0.1) 60%);
  animation: vortex-animation 6s linear infinite;
  z-index: 1;
}

.rarity-bg-4::after {
  content: "";
  position: absolute;
  width: 150%;
  height: 150%;
  top: -25%;
  left: -25%;
  background: repeating-conic-gradient(from 0deg, rgba(156, 39, 176, 0.1) 0deg 10deg, rgba(156, 39, 176, 0.2) 10deg 15deg, rgba(156, 39, 176, 0.1) 15deg 20deg);
  animation: particle-swirl 8s linear infinite reverse;
  z-index: 0;
}

.rarity-bg-5 {
  position: relative;
  overflow: hidden;
  background-color: #fff8e1;
}

.rarity-bg-5::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, rgba(255, 215, 0, 0.2), rgba(255, 105, 180, 0.2), rgba(100, 149, 237, 0.2));
  animation: gradient-animation 3s linear infinite;
  z-index: 1;
}

/* 稀有度边框样式 */
.rarity-border-1 {
    border: 1px solid #cccccc; /* 单线框 */
    box-shadow: 0 0 5rpx rgba(204, 204, 204, 0.5);
  }

.rarity-border-2 {
    border: 2px double #4CAF50; /* 双线框 */
    box-shadow: 0 0 5rpx rgba(76, 175, 80, 0.5);
  }

.rarity-border-3 {
    border: 2px solid #2196F3;
    border-radius: 12rpx;
    position: relative;
    box-shadow: 0 0 5rpx rgba(33, 150, 243, 0.5);
  }

.rarity-border-3::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background-image: radial-gradient(circle, rgba(33, 150, 243, 0.3) 2px, transparent 2px);
  background-size: 12px 12px;
  pointer-events: none;
  z-index: 1;
}

.rarity-border-4 {
    position: relative;
    border: none;
    box-shadow: 0 0 15rpx rgba(156, 39, 176, 0.5);
  }

