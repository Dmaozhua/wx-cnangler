  border-radius: 16rpx;
  z-index: 0;
  animation: gear-rotation 10s linear infinite;
} */
.rarity-border-4::before {
    content: "";
    position: absolute;
    top: -2rpx;
    left: -2rpx;
    right: -2rpx;
    bottom: -2rpx;
    border-radius: 14rpx;
    background: linear-gradient(90deg, #e3e0e4, #a09e9f, #ad74db, #b1aea1);
    background-size: 400% 400%;
    animation: lightning-border 6s ease infinite;
    z-index: 0;
  }
.rarity-border-4::after {
  content: "";
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border: 2rpx solid rgba(156, 39, 176, 0.7);
  border-radius: 14rpx;
  background: linear-gradient(45deg, transparent 48%, rgba(156, 39, 176, 0.5) 50%, transparent 52%);
  background-size: 10px 10px;
  animation: border-light 3s linear infinite;
  z-index: 0;
}

.rarity-border-5 {
    position: relative;
    border: none;
    box-shadow: 0 0 15rpx rgba(255, 215, 0, 0.5);
  }

.rarity-border-5::before {
  content: "";
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #FFD700, #FF69B4, #6495ED, #FFD700);
  background-size: 400% 400%;
  animation: lightning-border 3s ease infinite;
  z-index: 0;
}

/* 动画定义 */
@keyframes stripe-animation {
  0% { transform: translateX(0); }
  100% { transform: translateX(50%); }
}

@keyframes wave-animation {
  0% { transform: translateX(0); }
  50% { transform: translateX(33.3%); }
  100% { transform: translateX(0); }
}

@keyframes vortex-animation {
  0% {
    transform: rotate(0deg) scale(1);
    opacity: 0.7;
  }
  50% {
    transform: rotate(180deg) scale(1.1);
    opacity: 0.9;
  }
  100% {
    transform: rotate(360deg) scale(1);
    opacity: 0.7;
  }
}

@keyframes particle-swirl {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes gear-rotation {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes border-light {
  0% {
    background-position: 0 0;
    box-shadow: 0 0 5rpx rgba(156, 39, 176, 0.3);
  }
  50% {
    background-position: 10px 10px;
    box-shadow: 0 0 15rpx rgba(156, 39, 176, 0.7);
  }
  100% {
    background-position: 20px 20px;
    box-shadow: 0 0 5rpx rgba(156, 39, 176, 0.3);
  }
}

@keyframes gradient-animation {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes lightning-border {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.progress-container {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  
}

/* Neo Progress 样式 */
.neo-progress {
  width: 100%;
  max-width: 580rpx; /* 移除最大宽度限制 */
  height: 32rpx;
  background-color: #e0e0e0;
  border: 6rpx solid #000000;
  box-shadow: 8rpx 8rpx 0 #000000;
  overflow: hidden;

}

.progress-bar {
  height: 100%;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); /* 平滑过渡效果 */
}

.fish-progress-inner {
  background-color:rgb(255, 115, 15); /* 鱼儿血量进度条颜色 */
}

.line-progress-inner {
  background-color:rgb(131, 146, 190); /* 钓线状态进度条颜色 */
}

/* 标签和动画同行布局 */
.progress-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 5rpx;
}

.progress-label {
  font-size: 30rpx;
  color: #666;
  flex-shrink: 0;
}

.line-info {
  margin-top: 10rpx;
}

.qte-status {
  margin-top: 10rpx;
  padding: 10rpx;
  background-color: #f0f2f5;
  border-radius: 8rpx;
  text-align: center;
}

.qte-text {
  font-size: 32rpx;
  color:rgb(234, 130, 18);
  font-weight: bold;
}

/* 血量减少动画样式 */
.damage-animations-container {
  position: relative;
  height: 40rpx;
  flex: 1;
  margin-left: 20rpx;
}

.line-damage-animations-container {
  position: relative;
  height: 40rpx;
  flex: 1;
  margin-left: 20rpx;
}

.damage-animation {
  position: absolute;
  right: 10rpx;
  top: 0;
  opacity: 1;
}

.damage-text {
  color: #ff4d4f;
  font-size: 28rpx;
  font-weight: bold;
  text-shadow: 0 0 3rpx rgba(0, 0, 0, 0.3);
}
.damage-text1 {
    color:rgb(131, 146, 190);
    font-size: 28rpx;
    font-weight: bold;
    text-shadow: 0 0 3rpx rgba(0, 0, 0, 0.3);
  }

/* —— BOSS 稀有度文字 —— */
.rarity-5-boss {
    color: #FFD700; /* 金色文字 */

    font-weight: bold;
    text-shadow:
      0 0 2px rgba(255, 215, 0, 0.8),
      0 0 6px rgba(255, 215, 0, 0.6);
  }
  /* —— BOSS 状态下，“???” 的金属质感＋发光 —— */
  .rarity-5-boss .fish-name .char {
    /* 金属金色渐变文字 */
    background: linear-gradient(135deg,
      #FFF9DB 0%,
      #D4AF37 50%,
      #B58F0C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  
    /* 外发光效果 */
    text-shadow:
      0 0 4rpx rgba(212, 175, 55, 0.9),
      0 0 8rpx rgba(255, 215, 0, 0.7),
      0 0 12rpx rgba(212, 175, 55, 0.5);
  
    /* 叠加之前的淡入淡出动画 */
    animation: char-fade 1.8s infinite, char-glow 2.5s ease-in-out infinite;
}

  
  /* 文字发光节奏 */
  @keyframes char-glow {
    0%, 100% {
      text-shadow:
        0 0 4rpx rgba(212, 175, 55, 0.7),
        0 0 8rpx rgba(255, 215, 0, 0.5);
    }
    50% {
      text-shadow:
        0 0 8rpx rgba(255, 215, 0, 1),
        0 0 16rpx rgba(212, 175, 55, 0.8),
        0 0 24rpx rgba(255, 215, 0, 0.6);
    }
  }

/* —— BOSS 稀有度背景 —— */
.rarity-bg-5-boss {
    background-color: #1a1a1a; /* 深黑色底 */
    position: relative;
    overflow: hidden;
    border-radius: 16rpx;
  }

/* 背景细微金属光泽 */
.rarity-bg-5-boss::before {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(255, 217, 0, 0.24), transparent 70%);
    transform: scale(1.2) rotate(45deg);
    animation: boss-bg-shimmer 8s ease-in-out infinite;
    pointer-events: none;
    z-index: 1;
  }
  
.rarity-bg-5-boss::after {
    content: "";
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><circle cx="50" cy="50" r="2" fill="rgba(148, 0, 211, 0.3)"/><circle cx="20" cy="20" r="1" fill="rgba(148, 0, 211, 0.3)"/><circle cx="80" cy="80" r="1" fill="rgba(148, 0, 211, 0.3)"/></svg>');
    background-size: 20px 20px;
    animation: boss-star-swirl 10s linear infinite reverse;
    z-index: 0;
}

/* —— BOSS 稀有度边框 —— */
.rarity-border-5-boss {
    position: relative;
    border: 4rpx solid #FFD700;
    border-radius: 18rpx;
    box-shadow: 0 0 8rpx rgba(255, 215, 0, 0.6);
    z-index: 2;
  }




/* 边框内侧细微波动光晕 */
.rarity-border-5-boss::after {
    content: "";
    position: absolute;
    top: -4rpx;
    left: -4rpx;
    right: -4rpx;
    bottom: -4rpx;
    border-radius: 20rpx;
    background: transparent;
    box-shadow: inset 0 0 10rpx rgba(255, 215, 0, 0.4);
    animation: boss-border-pulse 4s ease-in-out infinite;
    z-index: -1;
  }
/* 新增 BOSS 相关动画定义 */
@keyframes boss-vortex-animation {
    0% {
        transform: rotate(0deg) scale(1);
        opacity: 0.7;
    }
    50% {
        transform: rotate(180deg) scale(1.2);
        opacity: 0.9;
    }
    100% {
        transform: rotate(360deg) scale(1);
        opacity: 0.7;
    }
}

@keyframes boss-star-swirl {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

@keyframes boss-lightning-border {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@keyframes boss-border-light {
    0% {
        background-position: 0 0;
        box-shadow: 0 0 5rpx rgba(148, 0, 211, 0.3);
    }
    50% {
        background-position: 10px 10px;
        box-shadow: 0 0 20rpx rgba(148, 0, 211, 0.7);
    }
    100% {
        background-position: 20px 20px;
        box-shadow: 0 0 5rpx rgba(148, 0, 211, 0.3);
    }
}

@keyframes text-flicker {
    from {
        opacity: 0.6;
    }
    to {
        opacity: 1;
    }
}
/* —— 动画 —— */
@keyframes boss-bg-shimmer {
    0%   { transform: scale(1.2) rotate(45deg) translateX(0); opacity: 0.6; }
    50%  { transform: scale(1.3) rotate(135deg) translateX(20%); opacity: 0.8; }
    100% { transform: scale(1.2) rotate(225deg) translateX(0); opacity: 0.6; }
  }
  
  @keyframes boss-border-pulse {
    0%   { box-shadow: inset 0 0 6rpx rgba(207, 177, 9, 0.521); }
    50%  { box-shadow: inset 0 0 14rpx rgba(255, 215, 0, 0.6); }
    100% { box-shadow: inset 0 0 6rpx rgba(255, 215, 0, 0.3); }
  }

  .boss-fish-name .char {
    /* 金属金色渐变文字 */
    background: linear-gradient(135deg,
      #FFF9DB 0%,
      #D4AF37 50%,
      #B58F0C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  
    /* 外发光效果 */
    text-shadow:
      0 0 4rpx rgba(212, 175, 55, 0.9),
      0 0 8rpx rgba(255, 215, 0, 0.7),
      0 0 12rpx rgba(212, 175, 55, 0.5);
  
    /* 叠加之前的淡入淡出动画 */
    animation: char-fade 1.8s infinite, char-glow 2.5s ease-in-out infinite;
}

/* 文字发光节奏 */
@keyframes char-glow {
    0%, 100% {
      text-shadow:
        0 0 4rpx rgba(212, 175, 55, 0.7),
        0 0 8rpx rgba(255, 215, 0, 0.5);
    }
    50% {
      text-shadow:
        0 0 8rpx rgba(255, 215, 0, 1),
        0 0 16rpx rgba(212, 175, 55, 0.8),
        0 0 24rpx rgba(255, 215, 0, 0.6);
    }
}