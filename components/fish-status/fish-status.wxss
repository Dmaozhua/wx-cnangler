.rarity-border-4::before {
    content: "";
    position: absolute;
    top: -2rpx;
    left: -2rpx;
    right: -2rpx;
    bottom: -2rpx;
    border-radius: 14rpx;
    background: linear-gradient(90deg, #e3e0e4, #a09e9f, #ad74db, #b1aea1);
    background-size: 400% 400%;
    animation: lightning-border 6s ease infinite;
    z-index: 0;
  }
.rarity-border-4::after {
  content: "";
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border: 2rpx solid rgba(156, 39, 176, 0.7);
  border-radius: 14rpx;
  background: linear-gradient(45deg, transparent 48%, rgba(156, 39, 176, 0.5) 50%, transparent 52%);
  background-size: 10px 10px;
  animation: border-light 3s linear infinite;
  z-index: 0;
}

.rarity-border-5 {
    position: relative;
    border: none;
    box-shadow: 0 0 15rpx rgba(255, 215, 0, 0.5);
  }

.rarity-border-5::before {
  content: "";
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #FFD700, #FF69B4, #6495ED, #FFD700);
  background-size: 400% 400%;
  animation: lightning-border 3s ease infinite;
  z-index: 0;
}

/* 动画定义 */
@keyframes stripe-animation {
  0% { transform: translateX(0); }
  100% { transform: translateX(50%); }
}

@keyframes wave-animation {
  0% { transform: translateX(0); }
  50% { transform: translateX(33.3%); }
  100% { transform: translateX(0); }
}

@keyframes vortex-animation {
  0% {
    transform: rotate(0deg) scale(1);
    opacity: 0.7;
  }
  50% {
    transform: rotate(180deg) scale(1.1);
    opacity: 0.9;
  }
  100% {
    transform: rotate(360deg) scale(1);
    opacity: 0.7;
  }
}

@keyframes particle-swirl {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes gear-rotation {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes border-light {
  0% {
    background-position: 0 0;
    box-shadow: 0 0 5rpx rgba(156, 39, 176, 0.3);
  }
  50% {
    background-position: 10px 10px;
    box-shadow: 0 0 15rpx rgba(156, 39, 176, 0.7);
  }
  100% {
    background-position: 20px 20px;
    box-shadow: 0 0 5rpx rgba(156, 39, 176, 0.3);
  }
}

@keyframes gradient-animation {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes lightning-border {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.progress-container {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

/* 自定义进度条样式 */
.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #f0f0f0; /* 背景色 */
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); /* 平滑过渡效果 */
}

.fish-progress-inner {
  background-color: #ff4d4f; /* 鱼儿血量进度条颜色 */
}

.line-progress-inner {
  background-color: #1E3A8A; /* 钓线状态进度条颜色 */
}

.progress-label {
  font-size: 30rpx;
  color: #666;
  margin-top: 5rpx;
}

.line-info {
  margin-top: 10rpx;
}

.qte-status {
  margin-top: 10rpx;
  padding: 10rpx;
  background-color: #f0f2f5;
  border-radius: 8rpx;
  text-align: center;
}

.qte-text {
  font-size: 32rpx;
  color:rgb(234, 130, 18);
  font-weight: bold;
}