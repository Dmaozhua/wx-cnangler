/* components/loadingdemo/loadingdemo.wxss */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #222;
  text-align: center;
}

.loading-text {
  color: #ccc;
  margin: 0 0 20rpx 0;
  font-size: 28rpx;
  font-family: verdana;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.loading-dots {
  display: flex;
  align-items: center;
  justify-content: center;
}

/*
 * Loading Dots
 */
.dot {
  display: inline-block;
  vertical-align: middle;
  width: 12rpx;
  height: 12rpx;
  margin: 4rpx;
  background: #007DB6;
  border-radius: 12rpx;
  animation: loading 1s infinite alternate;
}

/*
 * Dots Colors
 */
.dot:nth-child(2) {
  background: #008FB2;
  animation-delay: 0.2s;
}
.dot:nth-child(3) {
  background: #009B9E;
  animation-delay: 0.4s;
}
.dot:nth-child(4) {
  background: #00A77D;
  animation-delay: 0.6s;
}
.dot:nth-child(5) {
  background: #00B247;
  animation-delay: 0.8s;
}
.dot:nth-child(6) {
  background: #5AB027;
  animation-delay: 1.0s;
}
.dot:nth-child(7) {
  background: #A0B61E;
  animation-delay: 1.2s;
}

/*
 * Animation keyframes
 */
@keyframes loading {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}