<!-- 在 components/achievement-detail/achievement-detail.wxml 中 -->
<view class="achievement-detail-mask {{visible ? 'wx-show' : ''}}" catchtouchmove="preventTouchMove" bindtap="onMaskTap">
  <!-- 标题和关闭按钮 -->
  <view class="achievement-header" catchtap="preventBubble">
    <text class="achievement-title">成就详情</text>
    <view class="close-btn" bindtap="onClose">×</view>
  </view>
  
  <!-- 成就图标区域 -->
  <view class="achievement-icon-section">
  <view class="icon-background-animation"></view>
  <image 
    class="achievement-icon" 
    src="{{achievement.icon}}" 
    mode="aspectFit"
    catchtap="onIconTap"
  />
  </view>
  
  <!-- 成就信息区域 -->
  <view class="achievement-info-section" catchtap="preventBubble">
    <text class="achievement-name">{{achievement.title}}</text>
    <text class="achievement-desc">{{achievement.description}}</text>
    
    <view class="achievement-details">
      <view class="detail-item">
        <text class="detail-label">成就值:</text>
        <text class="detail-value">+{{achievement.score}}</text>
      </view>
      
      <view class="detail-item">
        <text class="detail-label">解锁时间:</text>
        <text class="detail-value">{{formattedTime || '未解锁'}}</text>
      </view>
      
      <view class="detail-item detail-content">
        <text class="detail-label">详情内容:</text>
        <text class="detail-value detail-text" wx:if="{{achievement.detailed}}">{{achievement.detailed}}</text>
        <text class="detail-value detail-text" wx:else>该成就尚未添加详细描述</text>
      </view>
    </view>
  </view>
</view>

<!-- 全屏图标显示 -->
<view 
  wx:if="{{showFullscreenIcon}}" 
  class="fullscreen-icon-mask {{showFullscreenIcon ? 'wx-show' : ''}}" 
  bindtap="onFullscreenClose"
  catchtouchmove="preventTouchMove"
>  <image class="fullscreen-icon" src="{{achievement.icon}}" mode="aspectFit" catchtap="preventBubble"/>
</view>