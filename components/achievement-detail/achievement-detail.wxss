/* components/achievement-detail/achievement-detail.wxss */
.achievement-detail-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 10000; /* 确保弹窗层级足够高 */
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
    backdrop-filter: blur(5px); /* 添加模糊效果 */
    transition: backdrop-filter 0.3s ease; /* 过渡效果 */
  }
  
  .achievement-detail-content {
    width: 85%;
    background-color: #fff;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.25);
    max-width: 650rpx;
    max-height: 85vh;
    border: 2rpx solid rgba(255, 255, 255, 0.3);
    display: flex;
    flex-direction: column;
    transform: scale(0.8); /* 初始缩放 */
    opacity: 0; /* 初始透明度 */
    transition: transform 0.3s ease, opacity 0.3s ease; /* 过渡效果 */
  }
  
  .achievement-detail-mask.wx-show .achievement-detail-content {
    transform: scale(1); /* 显示时缩放 */
    opacity: 1; /* 显示时透明度 */
  }
  
  .achievement-header {
    position: relative;
    padding: 30rpx;
    background: linear-gradient(135deg, #264A7A, #3498DB);
    color: #fff;
    text-align: center;
    border-bottom: 4rpx solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3); /* 文字阴影 */
  }
  
  .achievement-title {
    font-size: 36rpx;
    font-weight: bold;
  }
  
  .close-btn {
    position: absolute;
    top: 20rpx;
    right: 20rpx;
    width: 40rpx;
    height: 40rpx;
    line-height: 36rpx;
    text-align: center;
    font-size: 40rpx;
    color: #fff;
    border-radius: 50%;
    transition: color 0.3s ease; /* 过渡效果 */
  }
  
  .close-btn:hover {
    color: #f5f5f5; /* 悬停颜色 */
  }
  
  .achievement-body {
    padding: 30rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-y: auto;
    flex: 1;
  }
  
  .achievement-icon {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    margin-bottom: 25rpx;
    border: 6rpx solid #264A7A;
    box-shadow: 0 8rpx 20rpx rgba(72, 201, 176, 0.3);
    background-color: #f5f5f5;
    padding: 8rpx;
    position: relative;
    z-index: 1;
    transition: transform 0.3s ease; /* 过渡效果 */
  }
  
  .achievement-icon:hover {
    transform: scale(1.1); /* 悬停缩放 */
  }
  
  .achievement-icon::after {
    content: '';
    position: absolute;
    top: -10rpx;
    left: -10rpx;
    right: -10rpx;
    bottom: -10rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(72, 201, 176, 0.2), transparent 70%);
    z-index: -1;
  }
  
  .achievement-info {
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .achievement-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
    display: block;
    max-width: 90%;
  }
  
  .achievement-desc {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 16rpx;
    display: block;
    max-width: 90%;
    line-height: 1.4;
  }
  
  .achievement-score {
    font-size: 30rpx;
    color: #264A7A;
    font-weight: bold;
    background: rgba(72, 201, 176, 0.1);
    padding: 8rpx 16rpx;
    border-radius: 30rpx;
    display: inline-block;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1); /* 阴影 */
  }
  
  /* 解锁时间 */
  .unlock-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 16rpx 0;
    padding: 12rpx;
    background-color: rgba(72, 201, 176, 0.1);
    border-radius: 10rpx;
    border: 1rpx dashed #264A7A;
    width: 90%;
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1); /* 阴影 */
  }
  
  .time-label {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 5rpx;
  }
  
  .time-value {
    font-size: 28rpx;
    color: #264A7A;
    font-weight: bold;
  }
  
  .achievement-detail-section {
    margin-top: 16rpx;
    padding: 20rpx;
    background-color: #f5f7fa;
    border-radius: 10rpx;
    width: 90%;
    box-sizing: border-box;
    text-align: left;
    align-self: center;
    border: 1rpx solid rgba(72, 201, 176, 0.3);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s ease; /* 过渡效果 */
  }
  
  .achievement-detail-section:hover {
    box-shadow: 0 6rpx 15rpx rgba(0, 0, 0, 0.1); /* 悬停阴影 */
  }
  
  .detail-title {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
    display: block;
    margin-bottom: 10rpx;
    border-left: 6rpx solid #264A7A;
    padding-left: 10rpx;
  }
  
  .detail-text-container {
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8rpx;
    margin-top: 8rpx;
    padding: 10rpx;
    max-height: 300rpx;
    overflow-y: auto;
    box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1); /* 内阴影 */
  }
  
  .detail-text {
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
    word-wrap: break-word;
    white-space: normal;
    display: block;
    text-align: justify;
  }
  
  .achievement-footer {
    padding: 16rpx 30rpx 30rpx;
    display: flex;
    justify-content: center;
    background-color: #f9f9f9;
    border-top: 2rpx solid #eee;
    margin-top: auto;
  }
  
  .close-btn-text {
    background: linear-gradient(135deg, #264A7A, #3498DB);
    color: #fff;
    border-radius: 40rpx;
    font-size: 28rpx;
    padding: 16rpx 0;
    font-weight: bold;
    box-shadow: 0 6rpx 15rpx rgba(72, 201, 176, 0.4);
    border: none;
    width: 70%;
    transition: transform 0.3s ease, box-shadow 0.3s ease; /* 过渡效果 */
  }
  
  .close-btn-text:hover {
    transform: translateY(-2rpx); /* 悬停上移 */
    box-shadow: 0 8rpx 20rpx rgba(72, 201, 176, 0.6); /* 悬停阴影 */
  }
  
  .close-btn-text::after {
    display: none;
  }