/* components/achievement-detail/achievement-detail.wxss */
/* 全屏半透明黑色遮罩 - 高于navigation-bar层级 */
.achievement-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.8);
  z-index: 20000;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* box-sizing: border-box; */
  opacity: 0;
  transition: opacity 0.3s ease;
}

.achievement-detail-mask.wx-show {
  opacity: 1;
}

/* 标题区域 */
.achievement-header {
  position: absolute;
  top: 60rpx;
  left: 0;
  right: 0;
  padding: 0 30rpx;
  text-align: center;
  z-index: 10;
}

.achievement-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.close-btn {
  position: absolute;
  top: -10rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 40rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.close-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.1);
}

/* 成就图标区域 */
.achievement-icon-section {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 120rpx;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 15; /* 确保高于头部区域(z-index:10) */
    /* 新增 */
    width: 60%;
    min-height: 500rpx;
    padding: 30rpx 0; /* 增加垂直间距 */
    /* background-color: rgba(255, 0, 0, 0.2); 调试用 */
}

/* 动画背景 */
.icon-background-animation {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 1;
  pointer-events: none; /* 让点击事件穿透到下面的图标 */
}

/* 脉冲圆圈动画点 */
.pulse-dot {
  position: absolute;
  border-radius: 50%;
  animation: pulseGlow 3s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.5);
    opacity: 0.3;
  }
}

/* 旋转轨道容器 */
.orbit-container {
  position: absolute;
  width: 100%;
  height: 100%;
  animation: rotateOrbit 8s linear infinite;
}

.orbit-dot {
  position: absolute;
  border-radius: 50%;
}

@keyframes rotateOrbit {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 序列环动画点 */
.ring-dot {
  position: absolute;
  border-radius: 50%;
  animation: expandRing 3s infinite;
}

@keyframes expandRing {
  0% {
    transform: scale(0.5);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.4;
  }
  100% {
    transform: scale(0.5);
    opacity: 0.8;
  }
}

/* 同心旋转容器 */
.concentric-container {
  position: absolute;
  width: 100%;
  height: 100%;
  animation: rotateConcentric 3s linear infinite;
}

.concentric-dot {
  position: absolute;
  border-radius: 50%;
}

@keyframes rotateConcentric {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.3;
  }
}

.achievement-icon {
  width: 80vw;
  height: 80vw;
  max-width: 400rpx;
  max-height: 400rpx;
  /* border-radius: 50%; */
  /* border: 6rpx solid rgba(255, 255, 255, 0.3); */
  /* box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.5), 0 0 80rpx rgba(255, 165, 0, 0.3); */
  /* background-color: rgba(255, 255, 255, 0.1); */
  z-index: 2;
  position: relative;
  transition: transform 0.3s ease;
  cursor: pointer;
}

.achievement-icon:active {
  transform: scale(0.95);
}

/* 成就信息区域 */
.achievement-info-section {
  width: 90%;
  max-width: 600rpx;
  padding: 30rpx 40rpx 50rpx;
  text-align: center;
  /* background: rgba(0, 0, 0, 0); */
  /* border-radius: 30rpx; */
  /* backdrop-filter: blur(20rpx); */
  /* border: 1rpx solid rgba(255, 255, 255, 0.1); */
}

.achievement-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
  line-height: 1.3;
}

.achievement-desc {
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  line-height: 1.5;
  opacity: 0.9;
}

/* 详情信息 */
.achievement-details {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.048);
  border-radius: 20rpx;
  /* border: 1rpx solid rgba(255, 255, 255, 0.2); */
  backdrop-filter: blur(10rpx);
}

.detail-item.detail-content {
  flex-direction: column;
  align-items: flex-start;
  gap: 15rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
  opacity: 0.8;
  min-width: 120rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: bold;
  text-align: right;
  flex: 1;
}

.detail-content .detail-value {
  text-align: left;
  line-height: 1.6;
  opacity: 0.9;
}

.detail-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.6;
  opacity: 0.9;
}

/* 全屏图标显示 */
.fullscreen-icon-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.87);
  z-index: 25000;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.fullscreen-icon-mask.wx-show {
  opacity: 1;
}

.fullscreen-icon {
  width: 90vw;
  height: 90vw;
  max-width: 80vh;
  max-height: 80vh;
  border-radius: 20rpx;
  /* box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.6), 0 0 120rpx rgba(255, 165, 0, 0.4); */
  animation: fullscreenPulse 5s ease-in-out infinite;
}

@keyframes fullscreenPulse {
  0%, 100% {
    transform: scale(1);
    /* box-shadow: 0 0 60rpx rgba(204, 203, 197, 0.6), 0 0 120rpx rgba(221, 216, 206, 0.4); */
  } 
  50% {
    transform: scale(1.02);
    /* box-shadow: 0 0 80rpx rgba(255, 215, 0, 0.8), 0 0 160rpx rgba(255, 165, 0, 0.6); */
  }
}