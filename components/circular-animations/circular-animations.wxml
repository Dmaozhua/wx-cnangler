<view class="header">
  <text class="main-title">圆形动画集合</text>
</view>
<view class="container">
  <!-- 1. 脉冲圆圈 -->
  <view class="animation-container">
    <view class="animation-title">脉冲圆圈</view>
    <view class="circle-container">
      <!-- 中心点 -->
      <view class="dot pulse-dot center-dot"></view>
      <!-- 脉冲圆圈 -->
      <view wx:for="{{pulsatingCircles}}" wx:key="id" 
            class="dot pulse-dot" 
            style="{{item.style}}"></view>
    </view>
  </view>
  
  <!-- 2. 旋转轨道 -->
  <view class="animation-container">
    <view class="animation-title">旋转轨道</view>
    <view class="circle-container">
      <!-- 中心点 -->
      <view class="dot center-dot"></view>
      <!-- 旋转轨道 -->
      <view wx:for="{{rotatingOrbits}}" wx:key="id" 
            class="orbit-container" 
            style="{{item.containerStyle}}">
        <view wx:for="{{item.dots}}" wx:for-item="dot" wx:key="id" 
              class="dot" 
              style="{{dot.style}}"></view>
      </view>
    </view>
  </view>
  
  <!-- 3. 序列环 -->
  <view class="animation-container">
    <view class="animation-title">序列环</view>
    <view class="circle-container">
      <!-- 中心点 -->
      <view class="dot center-dot-small"></view>
      <!-- 序列环 -->
      <view wx:for="{{sequentialRings}}" wx:key="id" 
            class="dot sequential-dot" 
            style="{{item.style}}"></view>
    </view>
  </view>
  
  <!-- 4. 同心旋转 -->
  <view class="animation-container">
    <view class="animation-title">同心旋转</view>
    <view class="circle-container">
      <view class="concentric-container">
        <!-- 中心点 -->
        <view class="dot center-dot-tiny"></view>
        <!-- 同心环 -->
        <view wx:for="{{concentricRings}}" wx:key="id" 
              class="concentric-ring" 
              style="{{item.containerStyle}}">
          <view wx:for="{{item.dots}}" wx:for-item="dot" wx:key="id" 
                class="dot" 
                style="{{dot.style}}"></view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 5. 圆形波浪 -->
  <view class="animation-container">
    <view class="animation-title">圆形波浪</view>
    <view class="circle-container">
      <!-- 中心点 -->
      <view class="dot center-dot"></view>
      <!-- 波浪点 -->
      <view wx:for="{{circularWaves}}" wx:key="id" 
            class="dot circular-wave-dot" 
            style="{{item.style}}"></view>
    </view>
  </view>
  
  <!-- 6. 扩展线条 -->
  <view class="animation-container">
    <view class="animation-title">扩展线条</view>
    <view class="circle-container">
      <!-- 中心点 -->
      <view class="dot center-dot"></view>
      <!-- 扩展线条 -->
      <view wx:for="{{expandingLines}}" wx:key="id" 
            class="expanding-line" 
            style="{{item.style}}"></view>
    </view>
  </view>
</view>